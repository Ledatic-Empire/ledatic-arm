-- armsim.rail -- MaxArm 4-DOF simulator, Rail-native
--
-- Geometry from arms/maxarm.json (firmware-canonical from
-- github.com/Hiwonder/MaxArm Arduino _espmax.h). FK/IK ported
-- byte-for-byte from _espmax.cpp.
--
-- Compile:  ./rail_native src/armsim.rail
-- Install:  cp /tmp/rail_out /tmp/armsim_handler && chmod +x /tmp/armsim_handler
-- Serve:    python3 serve.py 7071

import "stdlib/math.rail"
import "stdlib/env.rail"

-- ═════ Geometry reference (mm) -- mirrors arms/maxarm.json ═════
-- NOTE: Rail v5 miscompiles binary ops touching top-level float
-- constants (returns garbage like 1.11e+226). Geometry values are
-- inlined as literals at every use-site below; this block is for
-- humans only.
--    l0=84.4 l1=8.14 l2=128.4 l3=138.0 l4=16.8
--    z_max_mm=225.0  xy_min_mm=50.0
--    pi=3.14159265358979  2pi=6.28318530717958
--    deg2rad=0.01745329251994  rad2deg=57.29577951308232
--    yaw_offset=2.61799387799149 (= 150 deg in rad)

-- ═════ Pulse clamps (matches espmax.py set_servo_in_range) ═════
j1_p_lo = 0
j1_p_hi = 1000
j2_p_lo = 0
j2_p_hi = 700
j3_p_lo = 470
j3_p_hi = 1000
j4_us_lo = 500
j4_us_hi = 2500

-- Home pose pulses
home_p1     = 500
home_p2     = 500
home_p3     = 500
home_p4_us  = 1500
home_suction = 0   -- 0=off, 1=on, 2=venting

-- ═════ State paths ═════
req_path   = "/tmp/armsim_req.txt"
state_path = "/tmp/armsim_state.txt"
poses_path = "/tmp/armsim_poses.txt"
html_path  = "/tmp/armsim_index.html"

-- ═════ Attestation chain paths (ephemeral fallback) ═════
-- /tmp paths are the fallback when ARMSIM_EPHEMERAL=1. Production
-- paths are resolved via cp_* helpers and default to ~/.ledatic-arm/chain/.
chain_path      = "/tmp/armsim_chain.jsonl"
chain_head_path = "/tmp/armsim_chain_head.txt"
chain_idx_path  = "/tmp/armsim_chain_idx.txt"
attest_tmp_path = "/tmp/armsim_attest_tmp"
anchor_path     = "/tmp/armsim_anchors.jsonl"

-- ═════ E-stop / safety ═════
estop_path = "/tmp/armsim_estop.txt"     -- presence of file = e-stop active
-- z_floor: literal 5.0 inlined at use-sites (top-const float bug)

-- ═════ Bridge sink paths ═════
bridge_status_path  = "/tmp/armsim_bridge_status.txt"
bridge_default_fifo = "/tmp/armsim_bridge.fifo"

-- ═════ Motion plan path (one motion in flight at a time) ═════
motion_path = "/tmp/armsim_motion.txt"
-- Format: 10 newline-separated ints:
--   t_start_ms, duration_ms,
--   p1_from, p2_from, p3_from, p4_from,
--   p1_to, p2_to, p3_to, p4_to

-- ═════ Programs ═════
programs_dir_default = "/Users/ledaticempire/projects/ledatic-arm/programs"
program_runner_path = "/Users/ledaticempire/projects/ledatic-arm/tools/program_runner.sh"
program_pid_path    = "/tmp/armsim_program.pid"

-- ═════ Number formatting helpers ═════
c_to_d c =
  if c == "0" then 0 else if c == "1" then 1 else if c == "2" then 2
  else if c == "3" then 3 else if c == "4" then 4 else if c == "5" then 5
  else if c == "6" then 6 else if c == "7" then 7 else if c == "8" then 8
  else if c == "9" then 9 else 0 - 1

pi_acc cs acc =
  if cs == [] then acc
  else
    let c = head cs
    let d = c_to_d c
    if d < 0 then acc
    else pi_acc (tail cs) (acc * 10 + d)

parse_int_signed s =
  let cs = chars s
  if cs == [] then 0
  else if head cs == "-" then 0 - pi_acc (tail cs) 0
  else pi_acc cs 0

clamp_int lo hi x = if x < lo then lo else if x > hi then hi else x

float_round f =
  let half = 0.5
  if f > 0.0 - 0.000001 then float_to_int (f + half)
  else 0 - (float_to_int (0.0 - f + half))

-- ═════ HTTP request parsing ═════
crlf = shell "printf '\\r\\n'"

http_request_line req =
  let lines = str_split "\n" req
  if lines == [] then "" else head lines

http_path_with_query req =
  let parts = str_split " " (http_request_line req)
  if length parts < 2 then "/"
  else head (tail parts)

strip_query p =
  let parts = str_split "?" p
  head parts

extract_query p =
  let parts = str_split "?" p
  if length parts < 2 then ""
  else head (tail parts)

qp_search pairs key =
  if pairs == [] then 0
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search (tail pairs) key
    else if head kv == key then parse_int_signed (head (tail kv))
    else qp_search (tail pairs) key

qp_get q key = qp_search (str_split "&" q) key

qp_search_str pairs key =
  if pairs == [] then ""
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search_str (tail pairs) key
    else if head kv == key then head (tail kv)
    else qp_search_str (tail pairs) key

qp_get_str q key = qp_search_str (str_split "&" q) key

-- ═════ Pulse <-> joint-degree conversion (firmware _espmax.cpp) ═════
-- pulse 0..1000 maps to joint-frame degrees with per-joint offsets.
-- Joint 2 is INVERTED.

pulse_to_deg_j1 p =
  let pf = to_float p
  pf * 240.0 / 1000.0

pulse_to_deg_j2 p =
  let pf = to_float p
  let neg_scale = 0.0 - 240.0
  pf * neg_scale / 1000.0 + 210.0

pulse_to_deg_j3 p =
  let pf = to_float p
  pf * 240.0 / 1000.0 - 120.0

deg_to_pulse_j1 a = a * 1000.0 / 240.0

deg_to_pulse_j2 a =
  let neg_scale = 0.0 - 240.0
  (a - 210.0) * 1000.0 / neg_scale

deg_to_pulse_j3 a = (a + 120.0) * 1000.0 / 240.0

-- PWM nozzle servo: 500-2500 us maps to -90..+90 deg
us_to_deg_nozzle us =
  let usf = to_float us
  let scale = 1000.0
  (usf - 1500.0) * 90.0 / scale

deg_to_us_nozzle deg = 1500.0 + deg * 1000.0 / 90.0

-- ═════ Trig helpers ═════
-- All top-const-free per v5 miscompile workaround.

deg_to_rad d = d * 0.01745329251994

rad_to_deg r = r * 57.29577951308232

acos_safe x =
  if x > 1.0 then 0.0
  else if x < 0.0 - 1.0 then 3.14159265358979
  else
    let xsq = pow x 2.0
    atan2 (sqrt (1.0 - xsq)) x

-- ═════ Forward kinematics -- port of _espmax.cpp:forward ═════
-- Returns (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z).
--
-- Geometry recap:
--   - Base column rises in +z from origin to height L0.
--   - Shoulder pivot is at radial distance L1 from base axis, height L0.
--   - Upper arm (L2) goes from shoulder; angle from horizontal = pi - alpha2.
--   - Forearm (L3) goes from elbow; planar combine gives side_beta + alpha.
--   - Wrist at (L1 + side_beta*cos(alpha), L0 + side_beta*sin(alpha)) in arm plane.
--   - Tip = wrist + (L4, 0) in arm plane.
--   - World x_world = -r * cos(alpha1)  (firmware negates x)
--     World y_world =  r * sin(alpha1)
--
-- Note: alpha2 here is in radians from the j2_deg conversion.

fk_full p1 p2 p3 =
  -- Local copies of constants -- v5 miscompiles top-const in binary ops.
  let l0_l = 84.4
  let l1_l = 8.14
  let l2_l = 128.4
  let l3_l = 138.0
  let l4_l = 16.8
  let pi_l = 3.14159265358979
  let two_pi_l = 6.28318530717958
  let yaw_l = 2.61799387799149
  let a1d = pulse_to_deg_j1 p1
  let a2d = pulse_to_deg_j2 p2
  let a3d = pulse_to_deg_j3 p3
  let alpha1_raw = (deg_to_rad a1d) + yaw_l
  let alpha1 = if alpha1_raw > two_pi_l then alpha1_raw - two_pi_l else alpha1_raw
  let alpha2 = deg_to_rad a2d
  let alpha3 = deg_to_rad a3d
  let beta = alpha2 - alpha3
  let cos_beta = cos beta
  let l2sq = pow l2_l 2.0
  let l3sq = pow l3_l 2.0
  let two_l2_l3 = 2.0 * 128.4 * 138.0
  let side_beta_sq = l2sq + l3sq - two_l2_l3 * cos_beta
  let side_beta = sqrt side_beta_sq
  let two_l2_sb = 2.0 * side_beta * 128.4
  let cos_gamma_raw = (side_beta_sq + l2sq - l3sq) / two_l2_sb
  let cos_gamma = if cos_gamma_raw > 1.0 then 1.0 else cos_gamma_raw
  let gamma = acos_safe cos_gamma
  let alpha_gamma = pi_l - alpha2
  let alpha = alpha_gamma - gamma
  let cos_a1 = cos alpha1
  let sin_a1 = sin alpha1
  -- Shoulder pivot (arm plane: r=L1, z=L0)
  let sh_r = l1_l
  let sh_x = 0.0 - sh_r * cos_a1
  let sh_y = sh_r * sin_a1
  let sh_z = l0_l
  -- Elbow: upper arm tip in arm plane
  let cos_a2 = cos alpha2
  let sin_a2 = sin alpha2
  let el_r = l1_l - l2_l * cos_a2
  let el_x = 0.0 - el_r * cos_a1
  let el_y = el_r * sin_a1
  let el_z = l0_l + l2_l * sin_a2
  -- Wrist
  let cos_alpha = cos alpha
  let sin_alpha = sin alpha
  let wr_r_planar = side_beta * cos_alpha
  let wr_r = l1_l + wr_r_planar
  let wr_x = 0.0 - wr_r * cos_a1
  let wr_y = wr_r * sin_a1
  let wr_z = l0_l + side_beta * sin_alpha
  -- Tip
  let tl_r = wr_r + l4_l
  let tl_x = 0.0 - tl_r * cos_a1
  let tl_y = tl_r * sin_a1
  let tl_z = wr_z
  (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z)

-- ═════ Inverse kinematics -- port of _espmax.cpp:inverse ═════
-- Returns (a1_deg, a2_deg, a3_deg, reachable).

ik_theta1 x y =
  let pi_l = 3.14159265358979
  let two_pi_l = 6.28318530717958
  if x == 0.0 then
    if y > 0.0 - 0.000001 then pi_l / 2.0
    else
      let three_halves = 1.5
      pi_l * three_halves
  else if y == 0.0 then
    if x > 0.0 then 0.0
    else pi_l
  else
    let t = atan2 y x
    if t < 0.0 then t + two_pi_l else t

ik_solve x_in y_in z_in =
  let l0_l = 84.4
  let l1_l = 8.14
  let l2_l = 128.4
  let l3_l = 138.0
  let l4_l = 16.8
  let pi_l = 3.14159265358979
  let x = 0.0 - x_in
  let y = y_in
  let z = z_in - l0_l
  let theta1 = ik_theta1 x y
  let xsq = pow x 2.0
  let ysq = pow y 2.0
  let r_xy = sqrt (xsq + ysq)
  let r = r_xy - l1_l - l4_l
  let rsq = pow r 2.0
  let zsq = pow z 2.0
  let r2z2 = rsq + zsq
  let dist = sqrt r2z2
  let l2sq = pow l2_l 2.0
  let l3sq = pow l3_l 2.0
  if dist > 266.4 then (0.0, 0.0, 0.0, 0)
  else if r < 0.000001 then (0.0, 0.0, 0.0, 0)
  else
    let alpha = atan2 z r
    let two_l2_l3 = 2.0 * 128.4 * 138.0
    let beta_num = l2sq + l3sq - r2z2
    let beta_arg = beta_num / two_l2_l3
    let beta = acos_safe beta_arg
    let two_l2_dist = 2.0 * 128.4 * dist
    let gamma_num = l2sq + r2z2 - l3sq
    let gamma_arg = gamma_num / two_l2_dist
    let gamma = acos_safe gamma_arg
    let theta2 = pi_l - (alpha + gamma)
    let theta3 = pi_l - (alpha + beta + gamma)
    let angles_raw = rad_to_deg theta1
    let angles_norm = if angles_raw < 30.000001 then angles_raw + 360.0 else angles_raw
    let angle1 = angles_norm - 150.0
    let angle2 = rad_to_deg theta2
    let angle3 = rad_to_deg theta3
    (angle1, angle2, angle3, 1)

-- ═════ State persistence (5 lines: p1 p2 p3 p4_us suction) ═════
load_state _ =
  let content = read_file state_path
  if length content == 0 then (home_p1, home_p2, home_p3, home_p4_us, home_suction)
  else
    let lines = str_split "\n" content
    if length lines < 5 then (home_p1, home_p2, home_p3, home_p4_us, home_suction)
    else
      let p1 = parse_int_signed (head lines)
      let p2 = parse_int_signed (head (tail lines))
      let p3 = parse_int_signed (head (tail (tail lines)))
      let p4 = parse_int_signed (head (tail (tail (tail lines))))
      let su = parse_int_signed (head (tail (tail (tail (tail lines)))))
      (p1, p2, p3, p4, su)

save_state p1 p2 p3 p4 su =
  let body = join "\n" [show p1, show p2, show p3, show p4, show su, ""]
  let _ = write_file state_path body
  0

-- ═════ Suction state mapping ═════
suction_label s =
  if s == 1 then "on"
  else if s == 2 then "venting"
  else "off"

-- ═════ JSON string escape (for user-controlled values) ═════
json_escape_char c =
  if c == "\\" then "\\\\"
  else if c == "\"" then "\\\""
  else if c == "\n" then "\\n"
  else if c == "\r" then "\\r"
  else if c == "\t" then "\\t"
  else c

json_escape_acc cs acc =
  if cs == [] then acc
  else json_escape_acc (tail cs) (join "" [acc, json_escape_char (head cs)])

json_escape s = json_escape_acc (chars s) ""

-- ═════ Persistent chain path resolution ═════
-- Default: $HOME/.ledatic-arm/chain/   (mkdir -p on first call)
-- ARMSIM_EPHEMERAL=1 -> /tmp/           (legacy / harness tests)
resolve_chain_dir _ =
  let ephemeral = get_env "ARMSIM_EPHEMERAL"
  if length ephemeral > 0 then "/tmp"
  else
    let home = get_env "HOME"
    if length home == 0 then "/tmp"
    else
      let path = join "" [home, "/.ledatic-arm/chain"]
      let _ = shell (join "" ["mkdir -p ", path])
      path

cp_chain _      = join "" [resolve_chain_dir 0, "/armsim_chain.jsonl"]
cp_chain_head _ = join "" [resolve_chain_dir 0, "/armsim_chain_head.txt"]
cp_chain_idx _  = join "" [resolve_chain_dir 0, "/armsim_chain_idx.txt"]
cp_anchor _     = join "" [resolve_chain_dir 0, "/armsim_anchors.jsonl"]

-- ═════ Per-PID attest temp path (no race under serve.py threading) ═════
attest_tmp_for_pid _ =
  let pid = shell "echo $$ | tr -d '\n'"
  join "" ["/tmp/armsim_attest_tmp_", pid]

-- ═════ E-stop ═════
estop_is_active _ =
  let s = read_file estop_path
  length s > 0

-- ═════ Bridge config (env-driven) ═════
bridge_mode_env _ =
  let m = get_env "ARMSIM_BRIDGE"
  if length m == 0 then "off" else m

bridge_default_move_ms _ =
  let v = get_env "ARMSIM_DEFAULT_MOVE_MS"
  if length v == 0 then 800
  else parse_int_signed v

bridge_fifo_path_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_FIFO"
  if length v == 0 then bridge_default_fifo else v

bridge_tcp_host_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_HOST"
  if length v == 0 then "127.0.0.1" else v

bridge_tcp_port_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_PORT"
  if length v == 0 then 6000
  else parse_int_signed v

-- ═════ AA 55 byte frame builders (inline mirror of protocols/lewansoul.rail) ═════
br_sum_bytes_acc lst acc =
  if lst == [] then acc
  else br_sum_bytes_acc (tail lst) (acc + (head lst))

br_sum_bytes lst = br_sum_bytes_acc lst 0

br_chksum func len data_bytes =
  let s = func + len + (br_sum_bytes data_bytes)
  (255 - (s % 256)) % 256

br_build_set_angle p1 p2 p3 time_ms =
  let data = [p1 % 256, p1 / 256,
              p2 % 256, p2 / 256,
              p3 % 256, p3 / 256,
              time_ms % 256, time_ms / 256]
  let cs = br_chksum 1 8 data
  let frame = [170, 85, 1, 8]
  let with_data = append frame data
  append with_data [cs]

br_build_set_pwmservo us time_ms =
  let data = [us % 256, us / 256, time_ms % 256, time_ms / 256]
  let cs = br_chksum 5 4 data
  let frame = [170, 85, 5, 4]
  let with_data = append frame data
  append with_data [cs]

br_build_set_suction cmd_byte =
  let data = [cmd_byte]
  let cs = br_chksum 7 1 data
  let frame = [170, 85, 7, 1]
  let with_data = append frame data
  append with_data [cs]

-- list of byte-ints -> hex string with spaces
br_hex_digit d =
  if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2"
  else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5"
  else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8"
  else if d == 9 then "9" else if d == 10 then "A" else if d == 11 then "B"
  else if d == 12 then "C" else if d == 13 then "D" else if d == 14 then "E"
  else "F"

br_byte_to_hex b = join "" [br_hex_digit (b / 16), br_hex_digit (b % 16)]

br_bytes_to_hex_acc lst acc =
  if lst == [] then acc
  else
    let h = br_byte_to_hex (head lst)
    let nxt = if length acc == 0 then h else join " " [acc, h]
    br_bytes_to_hex_acc (tail lst) nxt

br_bytes_to_hex lst = br_bytes_to_hex_acc lst ""

-- list of byte-ints -> binary string via char_from_int
br_bytes_to_str_acc lst acc =
  if lst == [] then acc
  else br_bytes_to_str_acc (tail lst) (join "" [acc, char_from_int (head lst)])

br_bytes_to_str lst = br_bytes_to_str_acc lst ""

-- ═════ Bridge send (mode-dispatch) ═════
bridge_record_status mode frame_hex desc =
  let t = now_utc 0
  let status = join "" ["{\"mode\":\"", mode, "\",\"last_frame_t\":\"", t,
                        "\",\"last_frame_hex\":\"", frame_hex,
                        "\",\"last_frame_desc\":\"", desc, "\"}"]
  let _ = write_file bridge_status_path status
  0

bridge_write_to_sink frame_str frame_hex desc =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else if mode == "fifo" then
    let path = bridge_fifo_path_resolved 0
    let _ = write_file path frame_str
    let _ = bridge_record_status mode frame_hex desc
    1
  else if mode == "tcp" then
    let host = bridge_tcp_host_resolved 0
    let port = bridge_tcp_port_resolved 0
    -- nc backgrounded so /pose returns immediately (#8 async partial)
    let cmd = join "" ["( echo '", frame_hex, "' | xxd -r -p | nc -w1 ",
                       host, " ", show port, " ) >/dev/null 2>&1 &"]
    let _ = shell cmd
    let _ = bridge_record_status mode frame_hex desc
    1
  else 0

bridge_send_set_angle p1 p2 p3 time_ms =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_angle p1 p2 p3 time_ms
    let desc = join "" ["SET_ANGLE p1=", show p1, " p2=", show p2, " p3=", show p3, " t=", show time_ms]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

bridge_send_set_pwm us time_ms =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_pwmservo us time_ms
    let desc = join "" ["SET_PWMSERVO us=", show us, " t=", show time_ms]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

bridge_send_suction cmd_byte =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_suction cmd_byte
    let desc = join "" ["SET_SUCTIONNOZZLE cmd=", show cmd_byte]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

-- ═════ Attestation chain ═════
-- Every mutating route appends an entry to /tmp/armsim_chain.jsonl:
--   {"idx":N,"t":"...","kind":"...","params":"...",
--    "state_sha":"...","prev_sha":"...","sha":"..."}
-- where sha = SHA-256("<prev_sha>|<t>|<kind>|<params>|<state_sha>").
-- The chain is self-contained and tamper-evident locally; on-demand
-- /anchor publishes the head to the ledatic.org entropy beacon via
-- the existing rail/tools/attest/attest.rail pipeline.

-- Rail's `shell` returns the command output INCLUDING trailing newline.
-- Pipe through `tr -d '\n'` so values embedded in JSON strings don't
-- carry literal control characters.
now_utc _ = shell "date -u +%FT%TZ | tr -d '\n'"

-- Per-PID temp path avoids the race when serve.py runs concurrent
-- handler subprocesses (each subprocess has its own $$).
sha256_of data =
  let tmp = attest_tmp_for_pid 0
  let _ = write_file tmp data
  shell (join "" ["shasum -a 256 ", tmp, " | cut -d\" \" -f1 | tr -d '\n'"])

chain_current_head _ =
  let h = read_file (cp_chain_head 0)
  if length h == 0 then "genesis" else h

chain_current_idx _ =
  let s = read_file (cp_chain_idx 0)
  if length s == 0 then 0 else parse_int_signed s

-- Hash the action data directly (not the full state_json) so the chain
-- can be updated BEFORE state_json is built. This lets /state and the
-- response from mutating routes both show the up-to-date chain head.
--
-- state_canon = "p1,p2,p3,p4_us,suction" -- deterministic, FK is derivable.
attest_action kind params p1 p2 p3 p4 su =
  let prev = chain_current_head 0
  let next_idx = (chain_current_idx 0) + 1
  let t = now_utc 0
  let state_canon = join "," [show p1, show p2, show p3, show p4, show su]
  -- params is JSON-escaped because it may contain user-controlled bytes
  -- (e.g. /poses/load?name=<anything>). Canonical hashes the raw value.
  let canonical = join "|" [prev, t, kind, params, state_canon]
  let new_sha = sha256_of canonical
  let entry = join "" ["{\"idx\":", show next_idx,
                       ",\"t\":\"", t,
                       "\",\"kind\":\"", kind,
                       "\",\"params\":\"", json_escape params,
                       "\",\"state\":\"", state_canon,
                       "\",\"prev_sha\":\"", prev,
                       "\",\"sha\":\"", new_sha, "\"}\n"]
  let chp = cp_chain 0
  let existing = read_file chp
  let _ = write_file chp (join "" [existing, entry])
  let _ = write_file (cp_chain_head 0) new_sha
  let _ = write_file (cp_chain_idx 0) (show next_idx)
  new_sha

filter_nonempty lst =
  if lst == [] then []
  else
    let h = head lst
    if length h == 0 then filter_nonempty (tail lst)
    else cons h (filter_nonempty (tail lst))

-- Tip z extraction for floor check (avoids re-running FK in each caller)
fk_tip_z p1 p2 p3 =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  tl_z

-- Common rejection bodies
estop_response _ =
  let body = "{\"ok\":false,\"reason\":\"estop active - POST /clear to release\"}"
  http_response 423 "Locked" "application/json" body

z_floor_response z_got =
  let body = join "" ["{\"ok\":false,\"reason\":\"tip z below 5mm floor\",\"tip_z\":", sf z_got, "}"]
  http_response 422 "Unprocessable Entity" "application/json" body

parse_time_ms_or_default q =
  let s = qp_search_str (str_split "&" q) "time_ms"
  if length s == 0 then bridge_default_move_ms 0
  else parse_int_signed s

-- ═════ Wall-clock time in milliseconds (used for motion plan timestamps) ═════
-- Python startup ~50ms; called once per /pose (rare path), never per /state.
now_ms _ = shell "python3 -c 'import time; print(int(time.time()*1000))' | tr -d '\n'"

-- ═════ Motion plan persistence ═════
save_motion p1f p2f p3f p4f p1t p2t p3t p4t duration_ms =
  let ts = now_ms 0
  let body = join "\n" [ts, show duration_ms,
                        show p1f, show p2f, show p3f, show p4f,
                        show p1t, show p2t, show p3t, show p4t, ""]
  let _ = write_file motion_path body
  0

motion_is_active _ =
  let s = read_file motion_path
  length s > 0

-- read N-th line as int (with default 0)
motion_nth_int lines n =
  if lines == [] then 0
  else if n == 0 then parse_int_signed (head lines)
  else motion_nth_int (tail lines) (n - 1)

motion_json_object _ =
  if motion_is_active 0 == 0 then "null"
  else
    let content = read_file motion_path
    let lines = str_split "\n" content
    let ts   = motion_nth_int lines 0
    let dur  = motion_nth_int lines 1
    let p1f  = motion_nth_int lines 2
    let p2f  = motion_nth_int lines 3
    let p3f  = motion_nth_int lines 4
    let p4f  = motion_nth_int lines 5
    let p1t  = motion_nth_int lines 6
    let p2t  = motion_nth_int lines 7
    let p3t  = motion_nth_int lines 8
    let p4t  = motion_nth_int lines 9
    join "" ["{\"active\":true,",
             "\"t_start_ms\":", show ts, ",",
             "\"duration_ms\":", show dur, ",",
             "\"from_pulses\":[", show p1f, ",", show p2f, ",", show p3f, ",", show p4f, "],",
             "\"to_pulses\":[",   show p1t, ",", show p2t, ",", show p3t, ",", show p4t, "]}"]

-- ═════ JSON building ═════
sf x = show_float x

state_json p1 p2 p3 p4 su reach =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  let d1 = pulse_to_deg_j1 p1
  let d2 = pulse_to_deg_j2 p2
  let d3 = pulse_to_deg_j3 p3
  let d4 = us_to_deg_nozzle p4
  let s_lbl = suction_label su
  let c_head = chain_current_head 0
  let c_idx = chain_current_idx 0
  let estop = if estop_is_active 0 then 1 else 0
  let bmode = bridge_mode_env 0
  join "" [
    "{",
    "\"arm\":\"maxarm\",",
    "\"dof\":4,",
    "\"pulses\":[", show p1, ",", show p2, ",", show p3, ",", show p4, "],",
    "\"joints_deg\":[", sf d1, ",", sf d2, ",", sf d3, ",", sf d4, "],",
    "\"fk\":{",
      "\"base\":[0,0,0],",
      "\"shoulder\":[", sf sh_x, ",", sf sh_y, ",", sf sh_z, "],",
      "\"elbow\":[",    sf el_x, ",", sf el_y, ",", sf el_z, "],",
      "\"wrist\":[",    sf wr_x, ",", sf wr_y, ",", sf wr_z, "],",
      "\"tip\":[",      sf tl_x, ",", sf tl_y, ",", sf tl_z, "]",
    "},",
    "\"nozzle_deg\":", sf d4, ",",
    "\"suction\":\"", s_lbl, "\",",
    "\"links_mm\":[84.4,8.14,128.4,138.0,16.8],",
    "\"limits\":{\"z_max\":225,\"xy_min_radius\":50,\"z_floor\":5},",
    "\"reachable\":", show reach, ",",
    "\"estop\":", show estop, ",",
    "\"bridge\":\"", bmode, "\",",
    "\"motion\":", motion_json_object 0, ",",
    "\"chain\":{\"head\":\"", c_head, "\",\"idx\":", show c_idx, "}",
    "}"]

state_json_current _ =
  let (p1, p2, p3, p4, su) = load_state 0
  state_json p1 p2 p3 p4 su 1

-- ═════ HTTP response builder ═════
http_response status st ct body =
  let cr = crlf
  join "" ["HTTP/1.1 ", show status, " ", st, cr,
          "Content-Type: ", ct, cr,
          "Content-Length: ", show (length body), cr,
          "Cache-Control: no-store", cr,
          "Access-Control-Allow-Origin: *", cr,
          "Connection: close", cr,
          "Server: armsim/0.2-maxarm", cr, cr, body]

-- ═════ Route handlers ═════
route_state _ =
  http_response 200 "OK" "application/json" (state_json_current 0)

-- /pose?p1=&p2=&p3=&p4_us=&time_ms=
route_pose q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let raw_p1 = qp_get q "p1"
    let raw_p2 = qp_get q "p2"
    let raw_p3 = qp_get q "p3"
    let raw_p4 = qp_get q "p4_us"
    let q_pairs = str_split "&" q
    let s_p1 = qp_search_str q_pairs "p1"
    let s_p2 = qp_search_str q_pairs "p2"
    let s_p3 = qp_search_str q_pairs "p3"
    let s_p4 = qp_search_str q_pairs "p4_us"
    let np1 = if length s_p1 == 0 then cp1 else clamp_int j1_p_lo j1_p_hi raw_p1
    let np2 = if length s_p2 == 0 then cp2 else clamp_int j2_p_lo j2_p_hi raw_p2
    let np3 = if length s_p3 == 0 then cp3 else clamp_int j3_p_lo j3_p_hi raw_p3
    let np4 = if length s_p4 == 0 then cp4 else clamp_int j4_us_lo j4_us_hi raw_p4
    let tip_z = fk_tip_z np1 np2 np3
    if tip_z < 5.0 then z_floor_response tip_z
    else
      let tms = parse_time_ms_or_default q
      let _ = save_motion cp1 cp2 cp3 cp4 np1 np2 np3 np4 tms
      let _ = save_state np1 np2 np3 np4 csu
      let _ = attest_action "pose" q np1 np2 np3 np4 csu
      let _ = bridge_send_set_angle np1 np2 np3 tms
      let _ = bridge_send_set_pwm np4 tms
      http_response 200 "OK" "application/json" (state_json np1 np2 np3 np4 csu 1)

-- /reach?x=&y=&z=&time_ms= (mm)
route_reach q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let x = to_float (qp_get q "x")
    let y = to_float (qp_get q "y")
    let z_raw = to_float (qp_get q "z")
    let z_clamped = if z_raw > 225.0 then 225.0 else z_raw
    if z_raw < 5.0 then z_floor_response z_raw
    else
      let xsq = pow x 2.0
      let ysq = pow y 2.0
      let r_xy = sqrt (xsq + ysq)
      if r_xy < 50.0 then
        let _ = attest_action "reach_unreachable" q cp1 cp2 cp3 cp4 csu
        http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 0)
      else
        let (a1, a2, a3, ok) = ik_solve x y z_clamped
        if ok == 0 then
          let _ = attest_action "reach_unreachable" q cp1 cp2 cp3 cp4 csu
          http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 0)
        else
          let raw_p1 = float_round (deg_to_pulse_j1 a1)
          let raw_p2 = float_round (deg_to_pulse_j2 a2)
          let raw_p3 = float_round (deg_to_pulse_j3 a3)
          let np1 = clamp_int j1_p_lo j1_p_hi raw_p1
          let np2 = clamp_int j2_p_lo j2_p_hi raw_p2
          let np3 = clamp_int j3_p_lo j3_p_hi raw_p3
          let tip_z = fk_tip_z np1 np2 np3
          if tip_z < 5.0 then z_floor_response tip_z
          else
            let tms = parse_time_ms_or_default q
            let _ = save_motion cp1 cp2 cp3 cp4 np1 np2 np3 cp4 tms
            let _ = save_state np1 np2 np3 cp4 csu
            let _ = attest_action "reach" q np1 np2 np3 cp4 csu
            let _ = bridge_send_set_angle np1 np2 np3 tms
            http_response 200 "OK" "application/json" (state_json np1 np2 np3 cp4 csu 1)

-- /nozzle?deg=&time_ms=
route_nozzle q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let deg = qp_get q "deg"
    let degf = to_float deg
    let degc = if degf > 90.0 then 90.0
               else if degf < 0.0 - 90.0 then 0.0 - 90.0
               else degf
    let us_f = deg_to_us_nozzle degc
    let us_i = float_round us_f
    let np4 = clamp_int j4_us_lo j4_us_hi us_i
    let _ = save_state cp1 cp2 cp3 np4 csu
    let _ = attest_action "nozzle" q cp1 cp2 cp3 np4 csu
    let tms = parse_time_ms_or_default q
    let _ = bridge_send_set_pwm np4 tms
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 np4 csu 1)

-- /suction?cmd=on|vent|off
route_suction q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let cmd = qp_get_str q "cmd"
    let nsu = if cmd == "on" then 1
              else if cmd == "vent" then 2
              else if cmd == "off" then 0
              else csu
    let cmd_byte = if nsu == 1 then 1
                   else if nsu == 2 then 2
                   else 3
    let _ = save_state cp1 cp2 cp3 cp4 nsu
    let _ = attest_action "suction" q cp1 cp2 cp3 cp4 nsu
    let _ = bridge_send_suction cmd_byte
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 nsu 1)

-- /home?time_ms=
route_home q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let tms = parse_time_ms_or_default q
    let _ = save_motion cp1 cp2 cp3 cp4 home_p1 home_p2 home_p3 home_p4_us tms
    let _ = save_state home_p1 home_p2 home_p3 home_p4_us home_suction
    let _ = attest_action "home" "" home_p1 home_p2 home_p3 home_p4_us home_suction
    let _ = bridge_send_set_angle home_p1 home_p2 home_p3 tms
    let _ = bridge_send_set_pwm home_p4_us tms
    let _ = bridge_send_suction 3
    http_response 200 "OK" "application/json" (state_json home_p1 home_p2 home_p3 home_p4_us home_suction 1)

-- ═════ Named poses ═════
-- Storage: one line per pose, format `<name> <p1> <p2> <p3> <p4_us> <suction>`.

pose_items_loop lines =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then pose_items_loop (tail lines)
    else
      let parts = str_split " " line
      if length parts < 6 then pose_items_loop (tail lines)
      else
        let nm   = head parts
        let p1s  = head (tail parts)
        let p2s  = head (tail (tail parts))
        let p3s  = head (tail (tail (tail parts)))
        let p4s  = head (tail (tail (tail (tail parts))))
        let sus  = head (tail (tail (tail (tail (tail parts)))))
        let item = join "" ["{\"name\":\"", json_escape nm,
                            "\",\"pulses\":[", p1s, ",", p2s, ",", p3s, ",", p4s,
                            "],\"suction\":\"", suction_label (parse_int_signed sus),
                            "\"}"]
        cons item (pose_items_loop (tail lines))

poses_drop_name lines name =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then poses_drop_name (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 6 then poses_drop_name (tail lines) name
      else if head parts == name then poses_drop_name (tail lines) name
      else cons line (poses_drop_name (tail lines) name)

poses_find lines name =
  if lines == [] then ""
  else
    let line = head lines
    if length line == 0 then poses_find (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 6 then poses_find (tail lines) name
      else if head parts == name then line
      else poses_find (tail lines) name

route_poses _ =
  let lines = str_split "\n" (read_file poses_path)
  let items = pose_items_loop lines
  let body = join "" ["[", join "," items, "]"]
  http_response 200 "OK" "application/json" body

route_poses_save q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "text/plain" "missing name"
  else
    let (p1, p2, p3, p4, su) = load_state 0
    let existing = str_split "\n" (read_file poses_path)
    let pruned = poses_drop_name existing name
    let new_line = join " " [name, show p1, show p2, show p3, show p4, show su]
    let all_lines = append pruned (cons new_line [])
    let _ = write_file poses_path (join "" [join "\n" all_lines, "\n"])
    route_poses 0

route_poses_load q =
  if estop_is_active 0 then estop_response 0
  else
    let name = qp_get_str q "name"
    let lines = str_split "\n" (read_file poses_path)
    let line = poses_find lines name
    if length line == 0 then
      http_response 404 "Not Found" "text/plain" "pose not found"
    else
      let parts = str_split " " line
      let p1 = clamp_int j1_p_lo j1_p_hi (parse_int_signed (head (tail parts)))
      let p2 = clamp_int j2_p_lo j2_p_hi (parse_int_signed (head (tail (tail parts))))
      let p3 = clamp_int j3_p_lo j3_p_hi (parse_int_signed (head (tail (tail (tail parts)))))
      let p4 = clamp_int j4_us_lo j4_us_hi (parse_int_signed (head (tail (tail (tail (tail parts))))))
      let su = parse_int_signed (head (tail (tail (tail (tail (tail parts))))))
      let tip_z = fk_tip_z p1 p2 p3
      if tip_z < 5.0 then z_floor_response tip_z
      else
        let (cp1, cp2, cp3, cp4, csu) = load_state 0
        let tms = parse_time_ms_or_default q
        let _ = save_motion cp1 cp2 cp3 cp4 p1 p2 p3 p4 tms
        let _ = save_state p1 p2 p3 p4 su
        let _ = attest_action "poses_load" q p1 p2 p3 p4 su
        let _ = bridge_send_set_angle p1 p2 p3 tms
        let _ = bridge_send_set_pwm p4 tms
        http_response 200 "OK" "application/json" (state_json p1 p2 p3 p4 su 1)

route_poses_delete q =
  let name = qp_get_str q "name"
  let existing = str_split "\n" (read_file poses_path)
  let pruned = poses_drop_name existing name
  let body = join "\n" pruned
  let suffix = if pruned == [] then "" else "\n"
  let _ = write_file poses_path (join "" [body, suffix])
  route_poses 0

-- ═════ Attestation chain endpoints ═════

-- /chain  -- returns the JSONL chain wrapped as a JSON array
route_chain _ =
  let content = read_file (cp_chain 0)
  let lines = str_split "\n" content
  let entries = filter_nonempty lines
  let body = join "" ["[", join "," entries, "]"]
  http_response 200 "OK" "application/json" body

-- /anchor  -- shells out to rail/tools/attest/attest.rail to beacon-anchor
-- the current chain head against ledatic.org/entropy/pulse. Result is
-- appended to /tmp/armsim_anchors.jsonl. Returns the anchor JSON (or an
-- error JSON if attest.rail is unavailable / Pi witness offline).

anchor_input_path = "/tmp/armsim_chain_head_anchor.txt"

-- Fast pre-check: if fleet0 witness is unreachable, don't even try
-- running attest.rail (which would hang on the HTTP POST to /sign).
witness_alive _ =
  let probe = shell "curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://100.87.231.45:9102/health 2>/dev/null | tr -d '\n'"
  if probe == "200" then 1 else 0

run_anchor_attest head_sha =
  let _ = write_file anchor_input_path head_sha
  let _ = shell "rm -f /tmp/armsim_chain_head_anchor.txt.attestation.json"
  let cmd = "cd $HOME/projects/rail && $HOME/projects/rail/rail_native run tools/attest/attest.rail /tmp/armsim_chain_head_anchor.txt > /tmp/armsim_attest_run.log 2>&1"
  let _ = shell cmd
  read_file "/tmp/armsim_chain_head_anchor.txt.attestation.json"

anchor_success_body head_sha head_idx attest_json =
  let t = now_utc 0
  let anchor_entry = join "" ["{\"t\":\"", t, "\",\"head_idx\":", show head_idx, ",\"head_sha\":\"", head_sha, "\",\"attestation\":", attest_json, "}\n"]
  let ap = cp_anchor 0
  let existing = read_file ap
  let _ = write_file ap (join "" [existing, anchor_entry])
  join "" ["{\"ok\":true,\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, ",\"attestation\":", attest_json, "}"]

anchor_fail_body head_sha head_idx =
  join "" ["{\"ok\":false,\"reason\":\"attest.rail produced no output (Pi witness offline?)\",\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, "}"]

route_anchor _ =
  let head_sha = chain_current_head 0
  let head_idx = chain_current_idx 0
  if head_sha == "genesis" then
    http_response 200 "OK" "application/json" "{\"ok\":false,\"reason\":\"empty chain\"}"
  else if witness_alive 0 == 0 then
    http_response 503 "Service Unavailable" "application/json"
      (join "" ["{\"ok\":false,\"reason\":\"fleet0 witness offline\",\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, "}"])
  else
    let attest_json = run_anchor_attest head_sha
    if length attest_json == 0 then
      http_response 502 "Bad Gateway" "application/json" (anchor_fail_body head_sha head_idx)
    else
      http_response 200 "OK" "application/json" (anchor_success_body head_sha head_idx attest_json)

-- /anchors  -- list of historical anchors
route_anchors _ =
  let content = read_file (cp_anchor 0)
  let lines = str_split "\n" content
  let entries = filter_nonempty lines
  let body = join "" ["[", join "," entries, "]"]
  http_response 200 "OK" "application/json" body

-- /estop -- arm e-stop. Drops suction, locks mutating routes.
route_estop _ =
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  let _ = save_state cp1 cp2 cp3 cp4 0   -- drop suction
  let _ = write_file estop_path "1"
  let _ = attest_action "estop" "" cp1 cp2 cp3 cp4 0
  -- Tell the real arm too (if bridged): vent_close to release any held object.
  let _ = bridge_send_suction 3
  http_response 200 "OK" "application/json"
    (state_json cp1 cp2 cp3 cp4 0 1)

-- /clear -- release e-stop.
route_clear _ =
  let _ = shell (join "" ["rm -f ", estop_path])
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  let _ = attest_action "clear" "" cp1 cp2 cp3 cp4 csu
  http_response 200 "OK" "application/json"
    (state_json cp1 cp2 cp3 cp4 csu 1)

-- /actual -- stub. In sim mode this is identical to /state. When the
-- real-arm bridge is wired and READ_ANGLE round-trip is working, it
-- will return the arm's actual readback position instead.
route_actual _ =
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  http_response 200 "OK" "application/json"
    (state_json cp1 cp2 cp3 cp4 csu 1)

-- /bridge_status -- last byte frame the bridge sent (if any) + mode
route_bridge_status _ =
  let s = read_file bridge_status_path
  let bmode = bridge_mode_env 0
  let body = if length s == 0 then
               join "" ["{\"mode\":\"", bmode, "\",\"last_frame_t\":null,\"last_frame_hex\":\"\",\"last_frame_desc\":\"\"}"]
             else s
  http_response 200 "OK" "application/json" body

-- ═════ Programs ═════
-- Each program is a .txt file in programs/ with one step per line:
--   <p1> <p2> <p3> <p4_us> <time_ms> <wait_ms> <suction>
-- Comments start with #.

route_programs _ =
  let cmd = join "" ["ls -1 ", programs_dir_default, "/*.txt 2>/dev/null | sed 's|.*/||;s|\\.txt$||'"]
  let listing = shell cmd
  let lines = str_split "\n" listing
  let items = pose_list_items lines
  let body = join "" ["[", join "," items, "]"]
  http_response 200 "OK" "application/json" body

pose_list_items lines =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then pose_list_items (tail lines)
    else
      let item = join "" ["{\"name\":\"", json_escape line, "\"}"]
      cons item (pose_list_items (tail lines))

-- /program?name=X  -- background-launch the runner
route_program q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "application/json" "{\"ok\":false,\"reason\":\"missing name\"}"
  else
    let prog_file = join "" [programs_dir_default, "/", name, ".txt"]
    let exists_check = shell (join "" ["test -f ", prog_file, " && echo y || echo n"])
    if exists_check == "n" then
      http_response 404 "Not Found" "application/json"
        (join "" ["{\"ok\":false,\"reason\":\"program not found\",\"name\":\"", json_escape name, "\"}"])
    else
      let _ = shell (join "" ["( bash ", program_runner_path, " ", prog_file,
                              " & echo $! > ", program_pid_path, " ) >/dev/null 2>&1 &"])
      let _ = attest_action "program_start" (join "" ["name=", name]) 0 0 0 0 0
      http_response 202 "Accepted" "application/json"
        (join "" ["{\"ok\":true,\"program\":\"", json_escape name, "\",\"started\":true}"])

-- /program/stop  -- kill any running runner
route_program_stop _ =
  let pid = read_file program_pid_path
  if length pid == 0 then
    http_response 200 "OK" "application/json" "{\"ok\":true,\"stopped\":false,\"reason\":\"no program running\"}"
  else
    let _ = shell (join "" ["kill ", pid, " 2>/dev/null; pkill -P ", pid, " 2>/dev/null"])
    let _ = shell (join "" ["rm -f ", program_pid_path])
    let _ = attest_action "program_stop" "" 0 0 0 0 0
    http_response 200 "OK" "application/json" "{\"ok\":true,\"stopped\":true}"

-- ═════ Index ═════
route_index _ =
  let html = read_file html_path
  if length html == 0 then
    http_response 500 "Internal Server Error" "text/plain" "armsim: index.html not found"
  else
    http_response 200 "OK" "text/html" html

route_404 path =
  http_response 404 "Not Found" "text/plain" (join "" ["404 ", path])

-- ═════ Main dispatch ═════
main =
  let req = read_file req_path
  let path = http_path_with_query req
  let plain = strip_query path
  let query = extract_query path
  let resp =
    if plain == "/" then route_index 0
    else if plain == "/state" then route_state 0
    else if plain == "/pose" then route_pose query
    else if plain == "/reach" then route_reach query
    else if plain == "/nozzle" then route_nozzle query
    else if plain == "/suction" then route_suction query
    else if plain == "/home" then route_home query
    else if plain == "/poses" then route_poses 0
    else if plain == "/poses/save" then route_poses_save query
    else if plain == "/poses/load" then route_poses_load query
    else if plain == "/poses/delete" then route_poses_delete query
    else if plain == "/chain" then route_chain 0
    else if plain == "/anchor" then route_anchor 0
    else if plain == "/anchors" then route_anchors 0
    else if plain == "/estop" then route_estop 0
    else if plain == "/clear" then route_clear 0
    else if plain == "/actual" then route_actual 0
    else if plain == "/bridge_status" then route_bridge_status 0
    else if plain == "/programs" then route_programs 0
    else if plain == "/program" then route_program query
    else if plain == "/program/stop" then route_program_stop 0
    else route_404 plain
  let _ = write_file "/dev/stdout" resp
  0
