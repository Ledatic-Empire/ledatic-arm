-- armsim.rail — EEZYbotARM MK2 simulator, Rail-native (Phase A)
--
-- HTTP handler invoked per request by serve.py. Reads the request from
-- /tmp/armsim_req.txt, dispatches by path, persists joint state to
-- /tmp/armsim_state.txt, writes the HTTP response to stdout.
--
-- Compile:  ./rail_native tools/armsim/armsim.rail
-- Install:  cp /tmp/rail_out /tmp/armsim_handler && chmod +x /tmp/armsim_handler
-- Serve:    python3 tools/armsim/serve.py 7071

import "stdlib/math.rail"
import "stdlib/env.rail"

-- ═════ Geometry (meters) — mirrors arm.json ═════
l0 = 0.092
l1 = 0.135
l2 = 0.147

-- ═════ Joint limits (degrees) ═════
b_lo = 0 - 90
b_hi = 90
s_lo = 0
s_hi = 90
e_lo = 0 - 90
e_hi = 90

-- ═════ Paths ═════
req_path = "/tmp/armsim_req.txt"
state_path = "/tmp/armsim_state.txt"
poses_path = "/tmp/armsim_poses.txt"
html_path = "/tmp/armsim_index.html"

-- ═════ Number formatting helpers ═════
c_to_d c =
  if c == "0" then 0 else if c == "1" then 1 else if c == "2" then 2
  else if c == "3" then 3 else if c == "4" then 4 else if c == "5" then 5
  else if c == "6" then 6 else if c == "7" then 7 else if c == "8" then 8
  else if c == "9" then 9 else 0 - 1

pi_acc cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    let d = c_to_d c
    if d < 0 then acc
    else pi_acc (tail cs) (acc * 10 + d)

parse_int_signed s =
  let cs = chars s
  if length cs == 0 then 0
  else if head cs == "-" then 0 - pi_acc (tail cs) 0
  else pi_acc cs 0

clamp_int lo hi x = if x < lo then lo else if x > hi then hi else x

-- ═════ HTTP request parsing ═════
crlf = shell "printf '\\r\\n'"

http_request_line req =
  let lines = str_split "\n" req
  if length lines == 0 then "" else head lines

http_path_with_query req =
  let parts = str_split " " (http_request_line req)
  if length parts < 2 then "/"
  else head (tail parts)

strip_query p =
  let parts = str_split "?" p
  head parts

extract_query p =
  let parts = str_split "?" p
  if length parts < 2 then ""
  else head (tail parts)

-- Linear scan: query="b=10&s=45&e=0", key="s" → 45
qp_search pairs key =
  if length pairs == 0 then 0
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search (tail pairs) key
    else if head kv == key then parse_int_signed (head (tail kv))
    else qp_search (tail pairs) key

qp_get q key = qp_search (str_split "&" q) key

-- String-valued query param (e.g. ?name=foo). Returns "" if missing.
qp_search_str pairs key =
  if length pairs == 0 then ""
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search_str (tail pairs) key
    else if head kv == key then head (tail kv)
    else qp_search_str (tail pairs) key

qp_get_str q key = qp_search_str (str_split "&" q) key

-- ═════ State persistence (three integer degrees, newline separated) ═════
load_state _ =
  let content = read_file state_path
  if length content == 0 then (0, 45, 0)
  else
    let lines = str_split "\n" content
    if length lines < 3 then (0, 45, 0)
    else
      let b = parse_int_signed (head lines)
      let s = parse_int_signed (head (tail lines))
      let e = parse_int_signed (head (tail (tail lines)))
      (b, s, e)

-- HW output: when ARMSIM_TTY is set, emit a line-JSON pose to the
-- configured serial device. No-op in sim mode (env var unset).
hw_send_pose b s e =
  let tty = get_env "ARMSIM_TTY"
  if length tty == 0 then 0
  else
    let payload = join "" ["{\"t\":\"pose\",\"j\":[", show b, ",", show s, ",", show e, "]}"]
    let cmd = join "" ["printf '%s\\n' '", payload, "' > ", tty, " 2>/dev/null"]
    let _ = shell cmd
    0

save_state b s e =
  let _ = write_file state_path (join "\n" [show b, show s, show e, ""])
  hw_send_pose b s e

-- ═════ Forward kinematics ═════
deg_to_rad d = (to_float d) * pi / (to_float 180)

-- Returns (sh_z, el_x, el_y, el_z, tl_x, tl_y, tl_z). Shoulder pivot
-- sits on the base axis at height l0, so (0, 0, sh_z) is implicit.
fk b_deg s_deg e_deg =
  let b = deg_to_rad b_deg
  let s = deg_to_rad s_deg
  let e = deg_to_rad e_deg
  let sh_z = l0
  let r_e = l1 * (cos s)
  let z_e = l0 + l1 * (sin s)
  let cb = cos b
  let sb = sin b
  let el_x = r_e * cb
  let el_y = r_e * sb
  let el_z = z_e
  -- Forearm angle from horizontal: positive elbow bends forearm downward
  let fa = s - e
  let r_t = r_e + l2 * (cos fa)
  let z_t = z_e + l2 * (sin fa)
  let tl_x = r_t * cb
  let tl_y = r_t * sb
  let tl_z = z_t
  (sh_z, el_x, el_y, el_z, tl_x, tl_y, tl_z)

-- ═════ Inverse kinematics ═════
-- Elbow-up convention. Returns (b_deg, s_deg, e_deg, reachable) where
-- reachable is 1 if the target lies within the (l1+l2)/(|l1-l2|) annulus
-- around the shoulder pivot, 0 otherwise. Joint-limit clamping is
-- applied by the route handler, not here.
--
-- math.rail doesn't ship acos, so derive via atan2(sqrt(1-x²), x).
--
-- WORKAROUND: Rail v5.0.0 (and v3.6.1) miscompile arithmetic between two
-- bare top-level constant references — typechecker tags the result as
-- `int`, runtime segfaults on use. So all binary ops in this file keep
-- at least one operand as either a float literal or a local-let binding.
-- Top-level derived constants are built with `literal OP literal`, which
-- compiles correctly.

-- Pre-computed reach bounds (literal arithmetic — safe at top level).
r_max    = 0.135 + 0.147       -- l1 + l2  ≈ 0.282
r_min    = 0.147 - 0.135       -- |l1 - l2| ≈ 0.012
r_max_sq = 0.282 * 0.282       -- ≈ 0.079524
r_min_sq = 0.012 * 0.012       -- ≈ 0.000144

-- Local pi via function call (top-level `pi` CAF triggers the v5 arith bug
-- when used in binary ops; a fresh local-from-func is safe).
pi_v = 3.14159265358979

acos_safe x =
  if x > 1.0 then 0.0
  else if x < 0.0 - 1.0 then pi_v
  else
    let xsq = pow x 2.0
    atan2 (sqrt (1.0 - xsq)) x

rad_to_deg_round r =
  let lpi = 3.14159265358979
  let d = r * 180.0 / lpi
  if d > 0.0 - 0.000001 then float_to_int (d + 0.5)
  else 0 - (float_to_int (0.0 - d + 0.5))

-- Rail v5/v3.6 bug surface:
--   `same_ident OP same_ident` for floats segfaults (params, top-level
--   constants, and local lets all triggered). Function-call returns are
--   always clean locals.
--   Workarounds used below:
--     - squares via `pow v 2.0` (function call, distinct fresh local)
--     - all binary ops keep at least one literal or distinct-source local
--     - constants bound to local-lets up front to keep comparisons safe

ik_solve x y z =
  let pl0 = 0.092
  let pl1 = 0.135
  let pl2 = 0.147
  let pl1sq = 0.135 * 0.135
  let pl2sq = 0.147 * 0.147
  let rmaxsq_local = 0.282 * 0.282
  let rminsq_local = 0.012 * 0.012
  let b_rad = atan2 y x
  let xsq = pow x 2.0
  let ysq = pow y 2.0
  let r2 = xsq + ysq
  let dz = z - pl0
  let dzsq = pow dz 2.0
  let d2 = r2 + dzsq
  if d2 > rmaxsq_local then (rad_to_deg_round b_rad, 0, 0, 0)
  else if d2 < rminsq_local then (rad_to_deg_round b_rad, 0, 0, 0)
  else
    let r = sqrt r2
    let d = sqrt d2
    let alpha = atan2 dz r
    let two_pl1 = 2.0 * pl1
    let den_beta = two_pl1 * d
    let num_beta = (pl1sq + d2) - pl2sq
    let cos_beta = num_beta / den_beta
    let beta = acos_safe cos_beta
    let s_rad = alpha + beta
    let den_gamma = two_pl1 * pl2
    let num_gamma = (pl1sq - d2) + pl2sq
    let cos_gamma = num_gamma / den_gamma
    let gamma = acos_safe cos_gamma
    let lpi = 3.14159265358979
    let e_rad = lpi - gamma
    (rad_to_deg_round b_rad, rad_to_deg_round s_rad, rad_to_deg_round e_rad, 1)

-- ═════ JSON building ═════
sf x = show_float x

state_json_full b s e reachable =
  let (sh_z, el_x, el_y, el_z, tl_x, tl_y, tl_z) = fk b s e
  join "" [
    "{",
    "\"joints_deg\":[", show b, ",", show s, ",", show e, "],",
    "\"shoulder\":[0,0,", sf sh_z, "],",
    "\"elbow\":[", sf el_x, ",", sf el_y, ",", sf el_z, "],",
    "\"tool\":[", sf tl_x, ",", sf tl_y, ",", sf tl_z, "],",
    "\"links\":[", sf l0, ",", sf l1, ",", sf l2, "],",
    "\"reach_max\":", sf r_max, ",",
    "\"reach_min\":", sf r_min, ",",
    "\"reachable\":", show reachable, ",",
    "\"limits_deg\":{",
      "\"base\":[", show b_lo, ",", show b_hi, "],",
      "\"shoulder\":[", show s_lo, ",", show s_hi, "],",
      "\"elbow\":[", show e_lo, ",", show e_hi, "]",
    "}",
    "}"]

state_json b s e = state_json_full b s e 1

-- ═════ HTTP response ═════
http_response status st ct body =
  let cr = crlf
  join "" ["HTTP/1.1 ", show status, " ", st, cr,
          "Content-Type: ", ct, cr,
          "Content-Length: ", show (length body), cr,
          "Cache-Control: no-store", cr,
          "Connection: close", cr,
          "Server: armsim/0.1", cr, cr, body]

-- ═════ Routes ═════
route_state _ =
  let (b, s, e) = load_state 0
  http_response 200 "OK" "application/json" (state_json b s e)

route_pose q =
  let nb = clamp_int b_lo b_hi (qp_get q "b")
  let ns = clamp_int s_lo s_hi (qp_get q "s")
  let ne = clamp_int e_lo e_hi (qp_get q "e")
  let _ = save_state nb ns ne
  http_response 200 "OK" "application/json" (state_json nb ns ne)

route_home _ =
  let _ = save_state 0 45 0
  http_response 200 "OK" "application/json" (state_json 0 45 0)

-- /reach?x=&y=&z= — integer millimeters → IK → clamp → persist
route_reach q =
  let x = (to_float (qp_get q "x")) / 1000.0
  let y = (to_float (qp_get q "y")) / 1000.0
  let z = (to_float (qp_get q "z")) / 1000.0
  let (b_raw, s_raw, e_raw, reach) = ik_solve x y z
  let nb = clamp_int b_lo b_hi b_raw
  let ns = clamp_int s_lo s_hi s_raw
  let ne = clamp_int e_lo e_hi e_raw
  let _ = save_state nb ns ne
  http_response 200 "OK" "application/json" (state_json_full nb ns ne reach)

-- ═════ Named poses ═════
-- Storage: one line per pose, format `<name> <b> <s> <e>` (degrees).

pose_items_loop lines =
  if length lines == 0 then []
  else
    let line = head lines
    if length line == 0 then pose_items_loop (tail lines)
    else
      let parts = str_split " " line
      if length parts < 4 then pose_items_loop (tail lines)
      else
        let nm = head parts
        let bs = head (tail parts)
        let ss = head (tail (tail parts))
        let es = head (tail (tail (tail parts)))
        let item = join "" ["{\"name\":\"", nm, "\",\"joints_deg\":[", bs, ",", ss, ",", es, "]}"]
        cons item (pose_items_loop (tail lines))

-- Drop lines whose first token matches `name`; keep others.
poses_drop_name lines name =
  if length lines == 0 then []
  else
    let line = head lines
    if length line == 0 then poses_drop_name (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 4 then poses_drop_name (tail lines) name
      else if head parts == name then poses_drop_name (tail lines) name
      else cons line (poses_drop_name (tail lines) name)

-- Find a pose line by name. Returns "" if not found.
poses_find lines name =
  if length lines == 0 then ""
  else
    let line = head lines
    if length line == 0 then poses_find (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 4 then poses_find (tail lines) name
      else if head parts == name then line
      else poses_find (tail lines) name

route_poses _ =
  let lines = str_split "\n" (read_file poses_path)
  let items = pose_items_loop lines
  let body = join "" ["[", join "," items, "]"]
  http_response 200 "OK" "application/json" body

-- /poses/save?name=X — snapshots current state, replaces any existing X.
route_poses_save q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "text/plain" "missing name"
  else
    let (cb, cs, ce) = load_state 0
    let existing = str_split "\n" (read_file poses_path)
    let pruned = poses_drop_name existing name
    let new_line = join " " [name, show cb, show cs, show ce]
    let all_lines = append pruned (cons new_line [])
    let _ = write_file poses_path (join "" [join "\n" all_lines, "\n"])
    route_poses 0

-- /poses/load?name=X — applies the named pose (joint-clamped) to state.
route_poses_load q =
  let name = qp_get_str q "name"
  let lines = str_split "\n" (read_file poses_path)
  let line = poses_find lines name
  if length line == 0 then
    http_response 404 "Not Found" "text/plain" "pose not found"
  else
    let parts = str_split " " line
    let b = clamp_int b_lo b_hi (parse_int_signed (head (tail parts)))
    let s = clamp_int s_lo s_hi (parse_int_signed (head (tail (tail parts))))
    let e = clamp_int e_lo e_hi (parse_int_signed (head (tail (tail (tail parts)))))
    let _ = save_state b s e
    http_response 200 "OK" "application/json" (state_json b s e)

route_poses_delete q =
  let name = qp_get_str q "name"
  let existing = str_split "\n" (read_file poses_path)
  let pruned = poses_drop_name existing name
  let body = join "\n" pruned
  let suffix = if length pruned == 0 then "" else "\n"
  let _ = write_file poses_path (join "" [body, suffix])
  route_poses 0

route_index _ =
  let html = read_file html_path
  if length html == 0 then
    http_response 500 "Internal Server Error" "text/plain" "armsim: index.html not found"
  else
    http_response 200 "OK" "text/html" html

route_404 path =
  http_response 404 "Not Found" "text/plain" (join "" ["404 ", path])

-- ═════ Main ═════
main =
  let req = read_file req_path
  let path = http_path_with_query req
  let plain = strip_query path
  let query = extract_query path
  let resp =
    if plain == "/" then route_index 0
    else if plain == "/state" then route_state 0
    else if plain == "/pose" then route_pose query
    else if plain == "/home" then route_home 0
    else if plain == "/reach" then route_reach query
    else if plain == "/poses" then route_poses 0
    else if plain == "/poses/save" then route_poses_save query
    else if plain == "/poses/load" then route_poses_load query
    else if plain == "/poses/delete" then route_poses_delete query
    else route_404 plain
  let _ = write_file "/dev/stdout" resp
  0
