-- armsim.rail -- MaxArm 4-DOF simulator, Rail-native
--
-- Geometry from arms/maxarm.json (firmware-canonical from
-- github.com/Hiwonder/MaxArm Arduino _espmax.h). FK/IK ported
-- byte-for-byte from _espmax.cpp.
--
-- Compile:  ./rail_native src/armsim.rail
-- Install:  cp /tmp/rail_out /tmp/armsim_handler && chmod +x /tmp/armsim_handler
-- Serve:    python3 serve.py 7071

import "stdlib/math.rail"
import "stdlib/env.rail"

-- ═════ Geometry reference (mm) -- mirrors arms/maxarm.json ═════
-- GEOMETRY SSOT (A8): every kinematic constant lives here as a
-- per-constant zero-arg accessor (bare float-literal body). Consumers
-- (fk_full, ik_solve, ik_theta1, deg_to_rad, rad_to_deg, acos_safe,
-- state_json links_mm) bind a LOCAL at function top -- `let l0_l = g_l0 0`
-- -- and use that. So the z-floor gate's FK (fk_tip_z -> fk_full) can no
-- longer drift from the IK FK: one source feeds both.
--
-- Values MUST equal arms/maxarm.json links_mm (84.4/8.14/128.4/138.0/16.8).
-- maxarm.json is the human-canonical source; these accessors are the
-- runtime SSOT and the two must match.
--
-- The old "Rail v5 miscompiles binary ops touching top-level float
-- constants" workaround (inline literals everywhere) is now moot: the
-- top-const-float bug was fixed upstream (zemo-g/rail f851882, 2026-05-15).
-- A tuple-of-constants accessor is STILL unsafe (live tuple-destructure-float
-- codegen bug -> SIGSEGV / 2.2e-314), so the SSOT is per-constant zero-arg
-- functions, NEVER `geom _ = (l0,l1,...)`. Do NOT collapse this block.
--    z_max_mm=225.0  xy_min_mm=50.0  (workspace limits, owned elsewhere)
g_l0 _ = 84.4
g_l1 _ = 8.14
g_l2 _ = 128.4
g_l3 _ = 138.0
g_l4 _ = 16.8
g_pi _ = 3.14159265358979
g_two_pi _ = 6.28318530717958
g_yaw _ = 2.61799387799149
g_deg2rad _ = 0.01745329251994
g_rad2deg _ = 57.29577951308232

-- ═════ Pulse clamps (matches espmax.py set_servo_in_range) ═════
j1_p_lo = 0
j1_p_hi = 1000
j2_p_lo = 0
j2_p_hi = 700
j3_p_lo = 470
j3_p_hi = 1000
j4_us_lo = 500
j4_us_hi = 2500

-- Home pose pulses
home_p1     = 500
home_p2     = 500
home_p3     = 500
home_p4_us  = 1500
home_suction = 0   -- 0=off, 1=on, 2=venting

-- ═════ State paths ═════
req_path   = "/tmp/armsim_req.txt"
state_path = "/tmp/armsim_state.txt"
poses_path = "/tmp/armsim_poses.txt"
html_path  = "/tmp/armsim_index.html"

-- ═════ Attestation chain paths (ephemeral fallback) ═════
-- /tmp paths are the fallback when ARMSIM_EPHEMERAL=1. Production
-- paths are resolved via cp_* helpers and default to ~/.ledatic-arm/chain/.
chain_path      = "/tmp/armsim_chain.jsonl"
chain_head_path = "/tmp/armsim_chain_head.txt"
chain_idx_path  = "/tmp/armsim_chain_idx.txt"
attest_tmp_path = "/tmp/armsim_attest_tmp"
anchor_path     = "/tmp/armsim_anchors.jsonl"

-- ═════ E-stop / safety ═════
estop_path = "/tmp/armsim_estop.txt"     -- presence of file = e-stop active
-- z_floor: literal 5.0 inlined at use-sites (top-const float bug)

-- ═════ Bridge sink paths ═════
bridge_status_path  = "/tmp/armsim_bridge_status.txt"
bridge_default_fifo = "/tmp/armsim_bridge.fifo"

-- ═════ Motion plan path (one motion in flight at a time) ═════
motion_path = "/tmp/armsim_motion.txt"
-- Format: 10 newline-separated ints:
--   t_start_ms, duration_ms,
--   p1_from, p2_from, p3_from, p4_from,
--   p1_to, p2_to, p3_to, p4_to

-- ═════ Programs ═════
programs_dir_default = "/Users/ledaticempire/projects/ledatic-arm/programs"
program_runner_path = "/Users/ledaticempire/projects/ledatic-arm/tools/program_runner.sh"
program_pid_path    = "/tmp/armsim_program.pid"

-- ═════ Number formatting helpers ═════
c_to_d c =
  if c == "0" then 0 else if c == "1" then 1 else if c == "2" then 2
  else if c == "3" then 3 else if c == "4" then 4 else if c == "5" then 5
  else if c == "6" then 6 else if c == "7" then 7 else if c == "8" then 8
  else if c == "9" then 9 else 0 - 1

pi_acc cs acc =
  if cs == [] then acc
  else
    let c = head cs
    let d = c_to_d c
    if d < 0 then acc
    else pi_acc (tail cs) (acc * 10 + d)

parse_int_signed s =
  let cs = chars s
  if cs == [] then 0
  else if head cs == "-" then 0 - pi_acc (tail cs) 0
  else pi_acc cs 0

clamp_int lo hi x = if x < lo then lo else if x > hi then hi else x

float_round f =
  let half = 0.5
  if f > 0.0 - 0.000001 then float_to_int (f + half)
  else 0 - (float_to_int (0.0 - f + half))

-- ═════ HTTP request parsing ═════
crlf = shell "printf '\\r\\n'"

http_request_line req =
  let lines = str_split "\n" req
  if lines == [] then "" else head lines

http_path_with_query req =
  let parts = str_split " " (http_request_line req)
  if length parts < 2 then "/"
  else head (tail parts)

strip_query p =
  let parts = str_split "?" p
  head parts

extract_query p =
  let parts = str_split "?" p
  if length parts < 2 then ""
  else head (tail parts)

qp_search pairs key =
  if pairs == [] then 0
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search (tail pairs) key
    else if head kv == key then parse_int_signed (head (tail kv))
    else qp_search (tail pairs) key

qp_get q key = qp_search (str_split "&" q) key

qp_search_str pairs key =
  if pairs == [] then ""
  else
    let kv = str_split "=" (head pairs)
    if length kv < 2 then qp_search_str (tail pairs) key
    else if head kv == key then head (tail kv)
    else qp_search_str (tail pairs) key

qp_get_str q key = qp_search_str (str_split "&" q) key

-- ═════ Pulse <-> joint-degree conversion (firmware _espmax.cpp) ═════
-- pulse 0..1000 maps to joint-frame degrees with per-joint offsets.
-- Joint 2 is INVERTED.

pulse_to_deg_j1 p =
  let pf = to_float p
  pf * 240.0 / 1000.0

pulse_to_deg_j2 p =
  let pf = to_float p
  let neg_scale = 0.0 - 240.0
  pf * neg_scale / 1000.0 + 210.0

pulse_to_deg_j3 p =
  let pf = to_float p
  pf * 240.0 / 1000.0 - 120.0

deg_to_pulse_j1 a = a * 1000.0 / 240.0

deg_to_pulse_j2 a =
  let neg_scale = 0.0 - 240.0
  (a - 210.0) * 1000.0 / neg_scale

deg_to_pulse_j3 a = (a + 120.0) * 1000.0 / 240.0

-- PWM nozzle servo: 500-2500 us maps to -90..+90 deg
us_to_deg_nozzle us =
  let usf = to_float us
  let scale = 1000.0
  (usf - 1500.0) * 90.0 / scale

deg_to_us_nozzle deg = 1500.0 + deg * 1000.0 / 90.0

-- ═════ Trig helpers ═════
-- All top-const-free per v5 miscompile workaround.

deg_to_rad d =
  let deg2rad_l = g_deg2rad 0
  d * deg2rad_l

rad_to_deg r =
  let rad2deg_l = g_rad2deg 0
  r * rad2deg_l

acos_safe x =
  let pi_l = g_pi 0
  if x > 1.0 then 0.0
  else if x < 0.0 - 1.0 then pi_l
  else
    let xsq = pow x 2.0
    atan2 (sqrt (1.0 - xsq)) x

-- ═════ Forward kinematics -- port of _espmax.cpp:forward ═════
-- Returns (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z).
--
-- Geometry recap:
--   - Base column rises in +z from origin to height L0.
--   - Shoulder pivot is at radial distance L1 from base axis, height L0.
--   - Upper arm (L2) goes from shoulder; angle from horizontal = pi - alpha2.
--   - Forearm (L3) goes from elbow; planar combine gives side_beta + alpha.
--   - Wrist at (L1 + side_beta*cos(alpha), L0 + side_beta*sin(alpha)) in arm plane.
--   - Tip = wrist + (L4, 0) in arm plane.
--   - World x_world = -r * cos(alpha1)  (firmware negates x)
--     World y_world =  r * sin(alpha1)
--
-- Note: alpha2 here is in radians from the j2_deg conversion.

fk_full p1 p2 p3 =
  -- Local copies of the geometry SSOT accessors (C7: bind once at top).
  let l0_l = g_l0 0
  let l1_l = g_l1 0
  let l2_l = g_l2 0
  let l3_l = g_l3 0
  let l4_l = g_l4 0
  let pi_l = g_pi 0
  let two_pi_l = g_two_pi 0
  let yaw_l = g_yaw 0
  let a1d = pulse_to_deg_j1 p1
  let a2d = pulse_to_deg_j2 p2
  let a3d = pulse_to_deg_j3 p3
  let alpha1_raw = (deg_to_rad a1d) + yaw_l
  let alpha1 = if alpha1_raw > two_pi_l then alpha1_raw - two_pi_l else alpha1_raw
  let alpha2 = deg_to_rad a2d
  let alpha3 = deg_to_rad a3d
  let beta = alpha2 - alpha3
  let cos_beta = cos beta
  let l2sq = pow l2_l 2.0
  let l3sq = pow l3_l 2.0
  let two_l2_l3 = 2.0 * l2_l * l3_l
  let side_beta_sq = l2sq + l3sq - two_l2_l3 * cos_beta
  let side_beta = sqrt side_beta_sq
  let two_l2_sb = 2.0 * side_beta * l2_l
  let cos_gamma_raw = (side_beta_sq + l2sq - l3sq) / two_l2_sb
  let cos_gamma = if cos_gamma_raw > 1.0 then 1.0 else cos_gamma_raw
  let gamma = acos_safe cos_gamma
  let alpha_gamma = pi_l - alpha2
  let alpha = alpha_gamma - gamma
  let cos_a1 = cos alpha1
  let sin_a1 = sin alpha1
  -- Shoulder pivot (arm plane: r=L1, z=L0)
  let sh_r = l1_l
  let sh_x = 0.0 - sh_r * cos_a1
  let sh_y = sh_r * sin_a1
  let sh_z = l0_l
  -- Elbow: upper arm tip in arm plane
  let cos_a2 = cos alpha2
  let sin_a2 = sin alpha2
  let el_r = l1_l - l2_l * cos_a2
  let el_x = 0.0 - el_r * cos_a1
  let el_y = el_r * sin_a1
  let el_z = l0_l + l2_l * sin_a2
  -- Wrist
  let cos_alpha = cos alpha
  let sin_alpha = sin alpha
  let wr_r_planar = side_beta * cos_alpha
  let wr_r = l1_l + wr_r_planar
  let wr_x = 0.0 - wr_r * cos_a1
  let wr_y = wr_r * sin_a1
  let wr_z = l0_l + side_beta * sin_alpha
  -- Tip
  let tl_r = wr_r + l4_l
  let tl_x = 0.0 - tl_r * cos_a1
  let tl_y = tl_r * sin_a1
  let tl_z = wr_z
  (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z)

-- ═════ Inverse kinematics -- port of _espmax.cpp:inverse ═════
-- Returns (a1_deg, a2_deg, a3_deg, reachable).

ik_theta1 x y =
  let pi_l = g_pi 0
  let two_pi_l = g_two_pi 0
  if x == 0.0 then
    if y > 0.0 - 0.000001 then pi_l / 2.0
    else
      let three_halves = 1.5
      pi_l * three_halves
  else if y == 0.0 then
    if x > 0.0 then 0.0
    else pi_l
  else
    let t = atan2 y x
    if t < 0.0 then t + two_pi_l else t

ik_solve x_in y_in z_in =
  let l0_l = g_l0 0
  let l1_l = g_l1 0
  let l2_l = g_l2 0
  let l3_l = g_l3 0
  let l4_l = g_l4 0
  let pi_l = g_pi 0
  let x = 0.0 - x_in
  let y = y_in
  let z = z_in - l0_l
  let theta1 = ik_theta1 x y
  let xsq = pow x 2.0
  let ysq = pow y 2.0
  let r_xy = sqrt (xsq + ysq)
  let r = r_xy - l1_l - l4_l
  let rsq = pow r 2.0
  let zsq = pow z 2.0
  let r2z2 = rsq + zsq
  let dist = sqrt r2z2
  let l2sq = pow l2_l 2.0
  let l3sq = pow l3_l 2.0
  if dist > 266.4 then (0.0, 0.0, 0.0, 0)
  else if r < 0.000001 then (0.0, 0.0, 0.0, 0)
  else
    let alpha = atan2 z r
    let two_l2_l3 = 2.0 * l2_l * l3_l
    let beta_num = l2sq + l3sq - r2z2
    let beta_arg = beta_num / two_l2_l3
    let beta = acos_safe beta_arg
    let two_l2_dist = 2.0 * l2_l * dist
    let gamma_num = l2sq + r2z2 - l3sq
    let gamma_arg = gamma_num / two_l2_dist
    let gamma = acos_safe gamma_arg
    let theta2 = pi_l - (alpha + gamma)
    let theta3 = pi_l - (alpha + beta + gamma)
    let angles_raw = rad_to_deg theta1
    let angles_norm = if angles_raw < 30.000001 then angles_raw + 360.0 else angles_raw
    let angle1 = angles_norm - 150.0
    let angle2 = rad_to_deg theta2
    let angle3 = rad_to_deg theta3
    (angle1, angle2, angle3, 1)

-- ═════ State persistence (5 lines: p1 p2 p3 p4_us suction) ═════
load_state _ =
  let content = read_file state_path
  if length content == 0 then (home_p1, home_p2, home_p3, home_p4_us, home_suction)
  else
    let lines = str_split "\n" content
    if length lines < 5 then (home_p1, home_p2, home_p3, home_p4_us, home_suction)
    else
      let p1 = parse_int_signed (head lines)
      let p2 = parse_int_signed (head (tail lines))
      let p3 = parse_int_signed (head (tail (tail lines)))
      let p4 = parse_int_signed (head (tail (tail (tail lines))))
      let su = parse_int_signed (head (tail (tail (tail (tail lines)))))
      (p1, p2, p3, p4, su)

-- Atomic state write: write_file is O_TRUNC (compile.rail:4650), so a
-- crash mid-write would leave a truncated state file that load_state
-- silently maps back to HOME (and would then be chained as if real).
-- Write to <state_path>.tmp then `mv -f` (rename is atomic same-fs).
save_state p1 p2 p3 p4 su =
  let body = join "\n" [show p1, show p2, show p3, show p4, show su, ""]
  let tmp = join "" [state_path, ".tmp"]
  let _ = write_file tmp body
  let _ = shell (join "" ["mv -f ", tmp, " ", state_path])
  0

-- ═════ Suction state mapping ═════
suction_label s =
  if s == 1 then "on"
  else if s == 2 then "venting"
  else "off"

-- ═════ JSON string escape (for user-controlled values) ═════
json_escape_char c =
  if c == "\\" then "\\\\"
  else if c == "\"" then "\\\""
  else if c == "\n" then "\\n"
  else if c == "\r" then "\\r"
  else if c == "\t" then "\\t"
  else c

json_escape_acc cs acc =
  if cs == [] then acc
  else json_escape_acc (tail cs) (join "" [acc, json_escape_char (head cs)])

json_escape s = json_escape_acc (chars s) ""

-- ═════ Persistent chain path resolution ═════
-- Default: $HOME/.ledatic-arm/chain/   (mkdir -p on first call)
-- ARMSIM_EPHEMERAL=1 -> /tmp/           (legacy / harness tests)
resolve_chain_dir _ =
  let ephemeral = get_env "ARMSIM_EPHEMERAL"
  if length ephemeral > 0 then "/tmp"
  else
    let home = get_env "HOME"
    if length home == 0 then "/tmp"
    else
      let path = join "" [home, "/.ledatic-arm/chain"]
      let _ = shell (join "" ["mkdir -p ", path])
      path

cp_chain _      = join "" [resolve_chain_dir 0, "/armsim_chain.jsonl"]
cp_chain_head _ = join "" [resolve_chain_dir 0, "/armsim_chain_head.txt"]
cp_chain_idx _  = join "" [resolve_chain_dir 0, "/armsim_chain_idx.txt"]
cp_anchor _     = join "" [resolve_chain_dir 0, "/armsim_anchors.jsonl"]
-- A1 (C4): persisted last-chained observed seq -> idempotency. Written via
-- the C6 tmp+rename convention (write_file is O_TRUNC, never write the live
-- pointer in place).
cp_observed_seq _ = join "" [resolve_chain_dir 0, "/armsim_observed_seq.txt"]

-- ═════ Per-PID attest temp path (no race under serve.py threading) ═════
attest_tmp_for_pid _ =
  let pid = shell "echo $$ | tr -d '\n'"
  join "" ["/tmp/armsim_attest_tmp_", pid]

-- ═════ E-stop ═════
estop_is_active _ =
  let s = read_file estop_path
  length s > 0

-- ═════ Bridge config (env-driven) ═════
bridge_mode_env _ =
  let m = get_env "ARMSIM_BRIDGE"
  if length m == 0 then "off" else m

bridge_default_move_ms _ =
  let v = get_env "ARMSIM_DEFAULT_MOVE_MS"
  if length v == 0 then 800
  else parse_int_signed v

bridge_fifo_path_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_FIFO"
  if length v == 0 then bridge_default_fifo else v

bridge_tcp_host_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_HOST"
  if length v == 0 then "127.0.0.1" else v

bridge_tcp_port_resolved _ =
  let v = get_env "ARMSIM_BRIDGE_PORT"
  if length v == 0 then 6000
  else parse_int_signed v

-- ═════ AA 55 byte frame builders (inline mirror of protocols/lewansoul.rail) ═════
br_sum_bytes_acc lst acc =
  if lst == [] then acc
  else br_sum_bytes_acc (tail lst) (acc + (head lst))

br_sum_bytes lst = br_sum_bytes_acc lst 0

br_chksum func len data_bytes =
  let s = func + len + (br_sum_bytes data_bytes)
  (255 - (s % 256)) % 256

br_build_set_angle p1 p2 p3 time_ms =
  let data = [p1 % 256, p1 / 256,
              p2 % 256, p2 / 256,
              p3 % 256, p3 / 256,
              time_ms % 256, time_ms / 256]
  let cs = br_chksum 1 8 data
  let frame = [170, 85, 1, 8]
  let with_data = append frame data
  append with_data [cs]

br_build_set_pwmservo us time_ms =
  let data = [us % 256, us / 256, time_ms % 256, time_ms / 256]
  let cs = br_chksum 5 4 data
  let frame = [170, 85, 5, 4]
  let with_data = append frame data
  append with_data [cs]

br_build_set_suction cmd_byte =
  let data = [cmd_byte]
  let cs = br_chksum 7 1 data
  let frame = [170, 85, 7, 1]
  let with_data = append frame data
  append with_data [cs]

-- HALT (e-stop): func 0x7F, no data. The relay translates it to bus_servo.stop()
-- on all 3 joints -> interrupt any in-flight move NOW (servos hold, don't drop).
br_build_halt _ =
  let cs = br_chksum 127 0 []
  let frame = [170, 85, 127, 0]
  append frame [cs]

-- list of byte-ints -> hex string with spaces
br_hex_digit d =
  if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2"
  else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5"
  else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8"
  else if d == 9 then "9" else if d == 10 then "A" else if d == 11 then "B"
  else if d == 12 then "C" else if d == 13 then "D" else if d == 14 then "E"
  else "F"

br_byte_to_hex b = join "" [br_hex_digit (b / 16), br_hex_digit (b % 16)]

br_bytes_to_hex_acc lst acc =
  if lst == [] then acc
  else
    let h = br_byte_to_hex (head lst)
    let nxt = if length acc == 0 then h else join " " [acc, h]
    br_bytes_to_hex_acc (tail lst) nxt

br_bytes_to_hex lst = br_bytes_to_hex_acc lst ""

-- list of byte-ints -> binary string via char_from_int
br_bytes_to_str_acc lst acc =
  if lst == [] then acc
  else br_bytes_to_str_acc (tail lst) (join "" [acc, char_from_int (head lst)])

br_bytes_to_str lst = br_bytes_to_str_acc lst ""

-- ═════ Bridge send (mode-dispatch) ═════
bridge_record_status mode frame_hex desc =
  let t = now_utc 0
  let status = join "" ["{\"mode\":\"", mode, "\",\"last_frame_t\":\"", t,
                        "\",\"last_frame_hex\":\"", frame_hex,
                        "\",\"last_frame_desc\":\"", desc, "\"}"]
  let _ = write_file bridge_status_path status
  0

bridge_write_to_sink frame_str frame_hex desc =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else if mode == "fifo" then
    let path = bridge_fifo_path_resolved 0
    -- Write HEX (+newline), not the raw binary string: char_from_int 0 yields an
    -- EMPTY string in Rail, so binary frames silently drop every 0x00 byte
    -- (any pulse < 256 corrupts). Hex is NUL-free; the relay hex-decodes it.
    let _ = write_file path (join "" [frame_hex, char_from_int 10])
    let _ = bridge_record_status mode frame_hex desc
    1
  else if mode == "tcp" then
    let host = bridge_tcp_host_resolved 0
    let port = bridge_tcp_port_resolved 0
    -- nc backgrounded so /pose returns immediately (#8 async partial)
    let cmd = join "" ["( echo '", frame_hex, "' | xxd -r -p | nc -w1 ",
                       host, " ", show port, " ) >/dev/null 2>&1 &"]
    let _ = shell cmd
    let _ = bridge_record_status mode frame_hex desc
    1
  else 0

bridge_send_set_angle p1 p2 p3 time_ms =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_angle p1 p2 p3 time_ms
    let desc = join "" ["SET_ANGLE p1=", show p1, " p2=", show p2, " p3=", show p3, " t=", show time_ms]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

bridge_send_set_pwm us time_ms =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_pwmservo us time_ms
    let desc = join "" ["SET_PWMSERVO us=", show us, " t=", show time_ms]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

bridge_send_suction cmd_byte =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_set_suction cmd_byte
    let desc = join "" ["SET_SUCTIONNOZZLE cmd=", show cmd_byte]
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) desc

bridge_send_halt _ =
  let mode = bridge_mode_env 0
  if mode == "off" then 0
  else
    let frame = br_build_halt 0
    bridge_write_to_sink (br_bytes_to_str frame) (br_bytes_to_hex frame) "HALT bus_servo.stop"

-- ═════ Attestation chain ═════
-- Every mutating route appends an entry to /tmp/armsim_chain.jsonl:
--   {"idx":N,"t":"...","kind":"...","params":"...",
--    "state_sha":"...","prev_sha":"...","sha":"..."}
-- where sha = SHA-256("<prev_sha>|<t>|<kind>|<params>|<state_sha>").
-- The chain is self-contained and tamper-evident locally; on-demand
-- /anchor publishes the head to the ledatic.org entropy beacon via
-- the existing rail/tools/attest/attest.rail pipeline.

-- Rail's `shell` returns the command output INCLUDING trailing newline.
-- Pipe through `tr -d '\n'` so values embedded in JSON strings don't
-- carry literal control characters.
now_utc _ = shell "date -u +%FT%TZ | tr -d '\n'"

-- Per-PID temp path avoids the race when serve.py runs concurrent
-- handler subprocesses (each subprocess has its own $$).
sha256_of data =
  let tmp = attest_tmp_for_pid 0
  let _ = write_file tmp data
  shell (join "" ["shasum -a 256 ", tmp, " | cut -d\" \" -f1 | tr -d '\n'"])

chain_current_head _ =
  let h = read_file (cp_chain_head 0)
  if length h == 0 then "genesis" else h

chain_current_idx _ =
  let s = read_file (cp_chain_idx 0)
  if length s == 0 then 0 else parse_int_signed s

-- ═════ Atomic single-entry chain append (shared persistence tail) ═════
-- ROOT CAUSE this replaces: the old append did read_file (whole jsonl) ++
-- write_file (O_TRUNC) -- O(N^2) AND torn-write (file truncated to 0 first),
-- plus two further truncate-writes for head/idx that could desync on crash.
-- append_file has NO native ARM64 codegen, so the only atomic-append escape
-- hatch is shell() with `>>`. The entry bytes (which may include json_escaped
-- user params) go through a tmp FILE, never the shell arg list, so user bytes
-- never reach the command line. new_sha (64 hex) + show next_idx (digits) +
-- our own paths are all shell-safe.
--
-- ORDER IS LOAD-BEARING (verify_chain.py --repair relies on it):
--   1. append the entry line (cat tmp >> chain) -- the only torn window is
--      now the NEW line, never the 241KB chain
--   2. advance head via tmp+rename (atomic; a reader never sees a half head)
--   3. advance idx via tmp+rename
-- A crash after (1) but before (2) leaves the chain with one extra committed
-- entry the pointer doesn't know about; recovery resyncs the pointer FORWARD
-- to the last intact line. We never lose a committed entry and never advance
-- the pointer past an unwritten entry.
chain_persist new_sha next_idx entry =
  let chp = cp_chain 0
  let hp = cp_chain_head 0
  let ip = cp_chain_idx 0
  let etmp = join "" [attest_tmp_for_pid 0, ".entry"]
  let _ = write_file etmp entry
  let cmd = join "" ["{ cat ", etmp, " >> ", chp,
                     "; printf %s ", new_sha, " > ", hp, ".tmp && mv -f ", hp, ".tmp ", hp,
                     "; printf %s ", show next_idx, " > ", ip, ".tmp && mv -f ", ip, ".tmp ", ip,
                     "; rm -f ", etmp, "; }"]
  let _ = shell cmd
  new_sha

-- Hash the action data directly (not the full state_json) so the chain
-- can be updated BEFORE state_json is built. This lets /state and the
-- response from mutating routes both show the up-to-date chain head.
--
-- state_canon = "p1,p2,p3,p4_us,suction" -- deterministic, FK is derivable.
attest_action kind params p1 p2 p3 p4 su =
  let prev = chain_current_head 0
  let next_idx = (chain_current_idx 0) + 1
  let t = now_utc 0
  let state_canon = join "," [show p1, show p2, show p3, show p4, show su]
  -- params is JSON-escaped because it may contain user-controlled bytes
  -- (e.g. /poses/load?name=<anything>). Canonical hashes the raw value.
  let canonical = join "|" [prev, t, kind, params, state_canon]
  let new_sha = sha256_of canonical
  let entry = join "" ["{\"idx\":", show next_idx,
                       ",\"t\":\"", t,
                       "\",\"kind\":\"", kind,
                       "\",\"params\":\"", json_escape params,
                       "\",\"state\":\"", state_canon,
                       "\",\"prev_sha\":\"", prev,
                       "\",\"sha\":\"", new_sha, "\"}\n"]
  chain_persist new_sha next_idx entry

filter_nonempty lst =
  if lst == [] then []
  else
    let h = head lst
    if length h == 0 then filter_nonempty (tail lst)
    else cons h (filter_nonempty (tail lst))

-- Tip z extraction for floor check (avoids re-running FK in each caller)
fk_tip_z p1 p2 p3 =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  tl_z

-- ═════ Reachability from REAL pulses (A7 / C2) ═════
-- /actual must report whether the arm's ACTUAL pose (from the bus-servo
-- readback) is inside the workspace, not hardcode reachable=1. Reuses the
-- SAME fk_full + the SAME workspace constants as the IK reach gate so
-- /actual reachability is computed like-with-like vs /reach and /state:
--   z floor 5  (ik_solve floor sense / route_reach origin)
--   r_xy < 50  (base column, route_reach:954)
--   z > 225    (z_max workspace cap, route_reach:942)
-- A full inverse-distance dist>266.4 test is redundant once FK is the source
-- (an in-range pulse triple's FK tip is by construction within mechanical
-- reach); the planar+z gates are what matter for honesty. Returns 1=reachable
-- 0=outside.
reach_from_pulses p1 p2 p3 =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  let r_xy = sqrt ((pow tl_x 2.0) + (pow tl_y 2.0))
  if tl_z < 5.0 then 0
  else if r_xy < 50.0 then 0
  else if tl_z > 225.0 then 0
  else 1

-- ═════ Table-floor gate (A3 / C8) ═════
-- Real table floor: tip below this strikes the work surface. Mirrors
-- arms/safe_limits.json xyz.z[0]=120 and the new top-level "z_floor_mm":120.
-- LOCAL-const zero-arg accessors (NOT top-level float consts; same SSOT
-- strategy as the g_l* geometry accessors above). Consumers bind to a
-- local at function top, e.g. `let floor_l = table_floor_mm 0`.
--   table_floor_mm: real ~120mm work-surface floor (the operative gate).
--   origin_floor_mm: 5mm origin-plane sanity (kept -- below origin can
--     never be a real pose; 120 subsumes it but both are documented).
table_floor_mm _ = 120.0
origin_floor_mm _ = 5.0

-- ═════ Config-space safety envelope (A10 / C9) ═════
-- envelope_check p1 p2 p3 -> (ok, reason_code). A single combined-pose
-- predicate shared by route_pose, route_poses_load, /validate_program (A4)
-- and the sim, so sim-validation, program pre-flight, and live actuation
-- gate on IDENTICAL geometry. Clamp the pulses with j*_p_lo/hi BEFORE
-- calling (callers already do) so the envelope sees what is actually
-- actuated.
--   reason_code: 0=ok
--                1=tip below the real ~120mm table floor (work-surface strike)
--                2=tip below the 5mm origin plane (can never be a real pose)
--                3=tip inside the base column r_xy<50mm (self/base collision)
--                4=tip beyond max reach dist>266.4mm (IK would have no solution)
-- These are SIMPLE, honestly-labeled heuristics: floor + base-column +
-- max-reach. They do NOT model link-to-link self-intersection (the arm
-- folding onto its own forearm) -- that genuinely requires the physical
-- swept-volume measurement (tools/envelope_map.py, deferred to a human
-- session). Do NOT claim full collision safety from this predicate.
--
-- LOCAL-const zero-arg accessors (same SSOT strategy as g_l* / table_floor_mm;
-- NOT top-level float consts). base_radius_mm mirrors maxarm.json
-- workspace_mm.xy_min_radius=50 (and safe_limits is silent on it).
-- max_reach_mm mirrors the 266.4 guard inside ik_solve:330 -- if that
-- changes, change this too (they are the SAME workspace bound).
base_radius_mm _ = 50.0
max_reach_mm _ = 266.4

-- Reach distance is measured from the shoulder pivot height (L0 base column),
-- matching ik_solve's z' = z - L0 before the planar reach math.
envelope_check p1 p2 p3 =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  let l0_l = g_l0 0
  let floor_l = table_floor_mm 0
  let origin_l = origin_floor_mm 0
  let base_r_l = base_radius_mm 0
  let max_r_l = max_reach_mm 0
  let r_xy = sqrt ((pow tl_x 2.0) + (pow tl_y 2.0))
  let dz = tl_z - l0_l
  let dist = sqrt ((pow tl_x 2.0) + (pow tl_y 2.0) + (pow dz 2.0))
  if tl_z < origin_l then (0, 2)
  else if tl_z < floor_l then (0, 1)
  else if r_xy < base_r_l then (0, 3)
  else if dist > max_r_l then (0, 4)
  else (1, 0)

-- Map an envelope reason_code to the rejection-response JSON. floor/origin
-- reuse the C8 floor_response shape (so the viewer/A4 keep recognizing it);
-- base-column + max-reach get their own 422 bodies with the reason_code.
envelope_response p1 p2 p3 code =
  let tip_z = fk_tip_z p1 p2 p3
  if code == 1 then floor_response tip_z (table_floor_mm 0)
  else if code == 2 then floor_response tip_z (table_floor_mm 0)
  else if code == 3 then
    let body = join "" ["{\"ok\":false,\"reason\":\"tip inside base column (r_xy < ",
                        show (float_round (base_radius_mm 0)),
                        "mm, self/base collision)\",\"reason_code\":3,\"tip_z\":",
                        sf tip_z, "}"]
    http_response 422 "Unprocessable Entity" "application/json" body
  else
    let body = join "" ["{\"ok\":false,\"reason\":\"tip beyond max reach (dist > ",
                        sf (max_reach_mm 0),
                        "mm, no IK solution)\",\"reason_code\":4,\"tip_z\":",
                        sf tip_z, "}"]
    http_response 422 "Unprocessable Entity" "application/json" body

-- Common rejection bodies
estop_response _ =
  let body = "{\"ok\":false,\"reason\":\"estop active - POST /clear to release\"}"
  http_response 423 "Locked" "application/json" body

-- C8 422 shape: {"ok":false,"reason":"tip z <z> below table floor 120mm",
--                "tip_z":<z>,"floor_mm":120}
-- floor_mm is rendered as an int (C8/C3 show "120", not "120.0").
floor_response z_got floor_mm =
  let floor_i = float_round floor_mm
  let body = join "" ["{\"ok\":false,\"reason\":\"tip z ", sf z_got,
                      " below table floor ", show floor_i,
                      "mm\",\"tip_z\":", sf z_got,
                      ",\"floor_mm\":", show floor_i, "}"]
  http_response 422 "Unprocessable Entity" "application/json" body

-- Thin wrapper: defaults to the real table floor so callers that don't
-- pass a floor value (none after A3) reject against 120mm.
z_floor_response z_got = floor_response z_got (table_floor_mm 0)

parse_time_ms_or_default q =
  let s = qp_search_str (str_split "&" q) "time_ms"
  if length s == 0 then bridge_default_move_ms 0
  else parse_int_signed s

-- ═════ Wall-clock time in milliseconds (used for motion plan timestamps) ═════
-- Python startup ~50ms; called once per /pose (rare path), never per /state.
now_ms _ = shell "python3 -c 'import time; print(int(time.time()*1000))' | tr -d '\n'"

-- ═════ Motion plan persistence ═════
save_motion p1f p2f p3f p4f p1t p2t p3t p4t duration_ms =
  let ts = now_ms 0
  let body = join "\n" [ts, show duration_ms,
                        show p1f, show p2f, show p3f, show p4f,
                        show p1t, show p2t, show p3t, show p4t, ""]
  let _ = write_file motion_path body
  0

motion_is_active _ =
  let s = read_file motion_path
  length s > 0

-- read N-th line as int (with default 0)
motion_nth_int lines n =
  if lines == [] then 0
  else if n == 0 then parse_int_signed (head lines)
  else motion_nth_int (tail lines) (n - 1)

motion_json_object _ =
  if motion_is_active 0 == 0 then "null"
  else
    let content = read_file motion_path
    let lines = str_split "\n" content
    let ts   = motion_nth_int lines 0
    let dur  = motion_nth_int lines 1
    let p1f  = motion_nth_int lines 2
    let p2f  = motion_nth_int lines 3
    let p3f  = motion_nth_int lines 4
    let p4f  = motion_nth_int lines 5
    let p1t  = motion_nth_int lines 6
    let p2t  = motion_nth_int lines 7
    let p3t  = motion_nth_int lines 8
    let p4t  = motion_nth_int lines 9
    join "" ["{\"active\":true,",
             "\"t_start_ms\":", show ts, ",",
             "\"duration_ms\":", show dur, ",",
             "\"from_pulses\":[", show p1f, ",", show p2f, ",", show p3f, ",", show p4f, "],",
             "\"to_pulses\":[",   show p1t, ",", show p2t, ",", show p3t, ",", show p4t, "]}"]

-- ═════ JSON building ═════
sf x = show_float x

-- state_json SIGNATURE (CANONICAL, A2+A7 combined / C2): the existing 6
-- params (p1 p2 p3 p4 su reach) are UNCHANGED; A2 appends `loaded` (int:
-- 1=servos loaded/authoritative, 0=relaxed/sagging) and A7 appends
-- `joint_src` (string: "observed" only on the /actual joints-from-readback
-- paths, "commanded" everywhere else). The emitted C3 fields ("loaded" +
-- "sources") sit immediately after "reachable":. Wrist + suction are ALWAYS
-- "commanded" (LFD-01M PWM wrist + vacuum pump are open-loop, physically
-- un-sensable -- NEVER labeled observed). /state always emits loaded=1,
-- joints="commanded".
state_json p1 p2 p3 p4 su reach loaded joint_src =
  let (sh_x, sh_y, sh_z, el_x, el_y, el_z, wr_x, wr_y, wr_z, tl_x, tl_y, tl_z) = fk_full p1 p2 p3
  let d1 = pulse_to_deg_j1 p1
  let d2 = pulse_to_deg_j2 p2
  let d3 = pulse_to_deg_j3 p3
  let d4 = us_to_deg_nozzle p4
  let s_lbl = suction_label su
  let c_head = chain_current_head 0
  let c_idx = chain_current_idx 0
  let estop = if estop_is_active 0 then 1 else 0
  let bmode = bridge_mode_env 0
  join "" [
    "{",
    "\"arm\":\"maxarm\",",
    "\"dof\":4,",
    "\"pulses\":[", show p1, ",", show p2, ",", show p3, ",", show p4, "],",
    "\"joints_deg\":[", sf d1, ",", sf d2, ",", sf d3, ",", sf d4, "],",
    "\"fk\":{",
      "\"base\":[0,0,0],",
      "\"shoulder\":[", sf sh_x, ",", sf sh_y, ",", sf sh_z, "],",
      "\"elbow\":[",    sf el_x, ",", sf el_y, ",", sf el_z, "],",
      "\"wrist\":[",    sf wr_x, ",", sf wr_y, ",", sf wr_z, "],",
      "\"tip\":[",      sf tl_x, ",", sf tl_y, ",", sf tl_z, "]",
    "},",
    "\"nozzle_deg\":", sf d4, ",",
    "\"suction\":\"", s_lbl, "\",",
    "\"links_mm\":[84.4,8.14,128.4,138.0,16.8],",
    "\"limits\":{\"z_max\":225,\"xy_min_radius\":50,\"z_floor\":120,\"origin_floor\":5,\"base_radius\":50,\"max_reach\":266.4},",
    "\"reachable\":", show reach, ",",
    "\"loaded\":", show loaded, ",",
    "\"sources\":{\"joints\":\"", joint_src, "\",\"wrist\":\"commanded\",\"suction\":\"commanded\"},",
    "\"estop\":", show estop, ",",
    "\"bridge\":\"", bmode, "\",",
    "\"motion\":", motion_json_object 0, ",",
    "\"chain\":{\"head\":\"", c_head, "\",\"idx\":", show c_idx, "}",
    "}"]

state_json_current _ =
  let (p1, p2, p3, p4, su) = load_state 0
  state_json p1 p2 p3 p4 su 1 1 "commanded"

-- ═════ HTTP response builder ═════
http_response status st ct body =
  let cr = crlf
  join "" ["HTTP/1.1 ", show status, " ", st, cr,
          "Content-Type: ", ct, cr,
          "Content-Length: ", show (length body), cr,
          "Cache-Control: no-store", cr,
          "Access-Control-Allow-Origin: *", cr,
          "Connection: close", cr,
          "Server: armsim/0.2-maxarm", cr, cr, body]

-- ═════ Route handlers ═════
route_state _ =
  http_response 200 "OK" "application/json" (state_json_current 0)

-- /selftest_geom -- geometry SSOT sanity check (A8). Runs fk_tip_z at the
-- home pose (500,500,500) and asserts tip z ~= 212.8 (golden). If a future
-- edit re-inlines a constant or the FK drifts from the IK FK, this fails.
-- Non-actuating: no save_state / attest / bridge_send -- safe with bridge ON.
selftest_geom_ok z =
  let lo = 212.8 - 0.05
  let hi = 212.8 + 0.05
  if z < lo then 0 else if z > hi then 0 else 1

route_selftest_geom _ =
  let z = fk_tip_z home_p1 home_p2 home_p3
  let ok = selftest_geom_ok z
  let ok_str = if ok == 1 then "true" else "false"
  let body = join "" ["{\"ok\":", ok_str, ",\"home_tip_z\":", sf z,
                      ",\"golden\":212.8}"]
  http_response 200 "OK" "application/json" body

-- /pose?p1=&p2=&p3=&p4_us=&time_ms=
route_pose q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let raw_p1 = qp_get q "p1"
    let raw_p2 = qp_get q "p2"
    let raw_p3 = qp_get q "p3"
    let raw_p4 = qp_get q "p4_us"
    let q_pairs = str_split "&" q
    let s_p1 = qp_search_str q_pairs "p1"
    let s_p2 = qp_search_str q_pairs "p2"
    let s_p3 = qp_search_str q_pairs "p3"
    let s_p4 = qp_search_str q_pairs "p4_us"
    let np1 = if length s_p1 == 0 then cp1 else clamp_int j1_p_lo j1_p_hi raw_p1
    let np2 = if length s_p2 == 0 then cp2 else clamp_int j2_p_lo j2_p_hi raw_p2
    let np3 = if length s_p3 == 0 then cp3 else clamp_int j3_p_lo j3_p_hi raw_p3
    let np4 = if length s_p4 == 0 then cp4 else clamp_int j4_us_lo j4_us_hi raw_p4
    -- A3/A10 (C9) combined-pose envelope gate: table floor + origin plane +
    -- base-column + max-reach, AFTER clamp_int so we validate the pose that is
    -- actually actuated. Subsumes the old floor-only gate (codes 1/2 still
    -- return the C8 floor_response shape). No short-circuit in Rail -> the
    -- predicate nests its own if/else.
    let (env_ok, env_code) = envelope_check np1 np2 np3
    if env_ok == 0 then envelope_response np1 np2 np3 env_code
    else
      let tms = parse_time_ms_or_default q
      let _ = save_motion cp1 cp2 cp3 cp4 np1 np2 np3 np4 tms
      let _ = save_state np1 np2 np3 np4 csu
      let _ = attest_action "pose" q np1 np2 np3 np4 csu
      let _ = bridge_send_set_angle np1 np2 np3 tms
      let _ = bridge_send_set_pwm np4 tms
      http_response 200 "OK" "application/json" (state_json np1 np2 np3 np4 csu 1 1 "commanded")

-- /reach?x=&y=&z=&time_ms= (mm)
route_reach q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let x = to_float (qp_get q "x")
    let y = to_float (qp_get q "y")
    let z_raw = to_float (qp_get q "z")
    let z_clamped = if z_raw > 225.0 then 225.0 else z_raw
    -- A3/C8: reject a requested z below the real table floor early (z_clamped
    -- only bounds the HIGH side). Keep 5mm origin sanity. The resulting-tip
    -- check below is the authoritative backstop after IK + clamp_int.
    let req_floor_l = table_floor_mm 0
    let req_origin_l = origin_floor_mm 0
    if z_raw < req_origin_l then floor_response z_raw req_floor_l
    else if z_raw < req_floor_l then floor_response z_raw req_floor_l
    else
      let xsq = pow x 2.0
      let ysq = pow y 2.0
      let r_xy = sqrt (xsq + ysq)
      if r_xy < 50.0 then
        let _ = attest_action "reach_unreachable" q cp1 cp2 cp3 cp4 csu
        http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 0 1 "commanded")
      else
        let (a1, a2, a3, ok) = ik_solve x y z_clamped
        if ok == 0 then
          let _ = attest_action "reach_unreachable" q cp1 cp2 cp3 cp4 csu
          http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 0 1 "commanded")
        else
          let raw_p1 = float_round (deg_to_pulse_j1 a1)
          let raw_p2 = float_round (deg_to_pulse_j2 a2)
          let raw_p3 = float_round (deg_to_pulse_j3 a3)
          let np1 = clamp_int j1_p_lo j1_p_hi raw_p1
          let np2 = clamp_int j2_p_lo j2_p_hi raw_p2
          let np3 = clamp_int j3_p_lo j3_p_hi raw_p3
          let tip_z = fk_tip_z np1 np2 np3
          -- A3/C8 backstop: resulting tip vs real table floor, AFTER clamp_int.
          let reach_floor_l = table_floor_mm 0
          let reach_origin_l = origin_floor_mm 0
          if tip_z < reach_origin_l then floor_response tip_z reach_floor_l
          else if tip_z < reach_floor_l then floor_response tip_z reach_floor_l
          else
            let tms = parse_time_ms_or_default q
            let _ = save_motion cp1 cp2 cp3 cp4 np1 np2 np3 cp4 tms
            let _ = save_state np1 np2 np3 cp4 csu
            let _ = attest_action "reach" q np1 np2 np3 cp4 csu
            let _ = bridge_send_set_angle np1 np2 np3 tms
            http_response 200 "OK" "application/json" (state_json np1 np2 np3 cp4 csu 1 1 "commanded")

-- /nozzle?deg=&time_ms=
route_nozzle q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let deg = qp_get q "deg"
    let degf = to_float deg
    let degc = if degf > 90.0 then 90.0
               else if degf < 0.0 - 90.0 then 0.0 - 90.0
               else degf
    let us_f = deg_to_us_nozzle degc
    let us_i = float_round us_f
    let np4 = clamp_int j4_us_lo j4_us_hi us_i
    let _ = save_state cp1 cp2 cp3 np4 csu
    let _ = attest_action "nozzle" q cp1 cp2 cp3 np4 csu
    let tms = parse_time_ms_or_default q
    let _ = bridge_send_set_pwm np4 tms
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 np4 csu 1 1 "commanded")

-- /suction?cmd=on|vent|off
route_suction q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let cmd = qp_get_str q "cmd"
    let nsu = if cmd == "on" then 1
              else if cmd == "vent" then 2
              else if cmd == "off" then 0
              else csu
    let cmd_byte = if nsu == 1 then 1
                   else if nsu == 2 then 2
                   else 3
    let _ = save_state cp1 cp2 cp3 cp4 nsu
    let _ = attest_action "suction" q cp1 cp2 cp3 cp4 nsu
    let _ = bridge_send_suction cmd_byte
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 nsu 1 1 "commanded")

-- /home?time_ms=
route_home q =
  if estop_is_active 0 then estop_response 0
  else
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let tms = parse_time_ms_or_default q
    let _ = save_motion cp1 cp2 cp3 cp4 home_p1 home_p2 home_p3 home_p4_us tms
    let _ = save_state home_p1 home_p2 home_p3 home_p4_us home_suction
    let _ = attest_action "home" "" home_p1 home_p2 home_p3 home_p4_us home_suction
    let _ = bridge_send_set_angle home_p1 home_p2 home_p3 tms
    let _ = bridge_send_set_pwm home_p4_us tms
    let _ = bridge_send_suction 3
    http_response 200 "OK" "application/json" (state_json home_p1 home_p2 home_p3 home_p4_us home_suction 1 1 "commanded")

-- ═════ Named poses ═════
-- Storage: one line per pose, format `<name> <p1> <p2> <p3> <p4_us> <suction>`.

pose_items_loop lines =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then pose_items_loop (tail lines)
    else
      let parts = str_split " " line
      if length parts < 6 then pose_items_loop (tail lines)
      else
        let nm   = head parts
        let p1s  = head (tail parts)
        let p2s  = head (tail (tail parts))
        let p3s  = head (tail (tail (tail parts)))
        let p4s  = head (tail (tail (tail (tail parts))))
        let sus  = head (tail (tail (tail (tail (tail parts)))))
        let item = join "" ["{\"name\":\"", json_escape nm,
                            "\",\"pulses\":[", p1s, ",", p2s, ",", p3s, ",", p4s,
                            "],\"suction\":\"", suction_label (parse_int_signed sus),
                            "\"}"]
        cons item (pose_items_loop (tail lines))

poses_drop_name lines name =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then poses_drop_name (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 6 then poses_drop_name (tail lines) name
      else if head parts == name then poses_drop_name (tail lines) name
      else cons line (poses_drop_name (tail lines) name)

poses_find lines name =
  if lines == [] then ""
  else
    let line = head lines
    if length line == 0 then poses_find (tail lines) name
    else
      let parts = str_split " " line
      if length parts < 6 then poses_find (tail lines) name
      else if head parts == name then line
      else poses_find (tail lines) name

route_poses _ =
  let lines = str_split "\n" (read_file poses_path)
  let items = pose_items_loop lines
  let body = join "" ["[", join "," items, "]"]
  http_response 200 "OK" "application/json" body

route_poses_save q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "text/plain" "missing name"
  else
    let (p1, p2, p3, p4, su) = load_state 0
    let existing = str_split "\n" (read_file poses_path)
    let pruned = poses_drop_name existing name
    let new_line = join " " [name, show p1, show p2, show p3, show p4, show su]
    let all_lines = append pruned (cons new_line [])
    let _ = write_file poses_path (join "" [join "\n" all_lines, "\n"])
    route_poses 0

route_poses_load q =
  if estop_is_active 0 then estop_response 0
  else
    let name = qp_get_str q "name"
    let lines = str_split "\n" (read_file poses_path)
    let line = poses_find lines name
    if length line == 0 then
      http_response 404 "Not Found" "text/plain" "pose not found"
    else
      let parts = str_split " " line
      let p1 = clamp_int j1_p_lo j1_p_hi (parse_int_signed (head (tail parts)))
      let p2 = clamp_int j2_p_lo j2_p_hi (parse_int_signed (head (tail (tail parts))))
      let p3 = clamp_int j3_p_lo j3_p_hi (parse_int_signed (head (tail (tail (tail parts)))))
      let p4 = clamp_int j4_us_lo j4_us_hi (parse_int_signed (head (tail (tail (tail (tail parts))))))
      let su = parse_int_signed (head (tail (tail (tail (tail (tail parts))))))
      -- A3/A10 (C9) combined-pose envelope gate on the loaded+clamped pose
      -- (table floor + origin plane + base-column + max-reach). Same predicate
      -- as route_pose / /validate_program so a stored pose that strays into a
      -- combined-pose hazard is rejected identically.
      let (env_ok, env_code) = envelope_check p1 p2 p3
      if env_ok == 0 then envelope_response p1 p2 p3 env_code
      else
        let (cp1, cp2, cp3, cp4, csu) = load_state 0
        let tms = parse_time_ms_or_default q
        let _ = save_motion cp1 cp2 cp3 cp4 p1 p2 p3 p4 tms
        let _ = save_state p1 p2 p3 p4 su
        let _ = attest_action "poses_load" q p1 p2 p3 p4 su
        let _ = bridge_send_set_angle p1 p2 p3 tms
        let _ = bridge_send_set_pwm p4 tms
        http_response 200 "OK" "application/json" (state_json p1 p2 p3 p4 su 1 1 "commanded")

route_poses_delete q =
  let name = qp_get_str q "name"
  let existing = str_split "\n" (read_file poses_path)
  let pruned = poses_drop_name existing name
  let body = join "\n" pruned
  let suffix = if pruned == [] then "" else "\n"
  let _ = write_file poses_path (join "" [body, suffix])
  route_poses 0

-- ═════ Attestation chain endpoints ═════

-- /chain  -- returns the JSONL chain wrapped as a JSON array
route_chain _ =
  let content = read_file (cp_chain 0)
  let lines = str_split "\n" content
  let entries = filter_nonempty lines
  let body = join "" ["[", join "," entries, "]"]
  http_response 200 "OK" "application/json" body

-- /anchor  -- shells out to rail/tools/attest/attest.rail to beacon-anchor
-- the current chain head against ledatic.org/entropy/pulse. Result is
-- appended to /tmp/armsim_anchors.jsonl. Returns the anchor JSON (or an
-- error JSON if attest.rail is unavailable / Pi witness offline).

anchor_input_path = "/tmp/armsim_chain_head_anchor.txt"

-- Fast pre-check: if fleet0 witness is unreachable, don't even try
-- running attest.rail (which would hang on the HTTP POST to /sign).
witness_alive _ =
  let probe = shell "curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://100.87.231.45:9102/health 2>/dev/null | tr -d '\n'"
  if probe == "200" then 1 else 0

run_anchor_attest head_sha =
  let _ = write_file anchor_input_path head_sha
  let _ = shell "rm -f /tmp/armsim_chain_head_anchor.txt.attestation.json"
  let cmd = "cd $HOME/projects/rail && $HOME/projects/rail/rail_native run tools/attest/attest.rail /tmp/armsim_chain_head_anchor.txt > /tmp/armsim_attest_run.log 2>&1"
  let _ = shell cmd
  read_file "/tmp/armsim_chain_head_anchor.txt.attestation.json"

anchor_success_body head_sha head_idx attest_json =
  let t = now_utc 0
  let anchor_entry = join "" ["{\"t\":\"", t, "\",\"head_idx\":", show head_idx, ",\"head_sha\":\"", head_sha, "\",\"attestation\":", attest_json, "}\n"]
  -- Anchor file is a growing forensic JSONL; write_file is O_TRUNC, so a
  -- crash mid-write would corrupt prior anchor history. /anchor is a rare
  -- manual route, so the O(N) read-rewrite is acceptable -- but stage it
  -- through <ap>.tmp then `mv -f` (atomic same-fs) per the C6 convention so
  -- the live file is never truncated in place.
  let ap = cp_anchor 0
  let existing = read_file ap
  let atmp = join "" [ap, ".tmp"]
  let _ = write_file atmp (join "" [existing, anchor_entry])
  let _ = shell (join "" ["mv -f ", atmp, " ", ap])
  join "" ["{\"ok\":true,\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, ",\"attestation\":", attest_json, "}"]

anchor_fail_body head_sha head_idx =
  join "" ["{\"ok\":false,\"reason\":\"attest.rail produced no output (Pi witness offline?)\",\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, "}"]

route_anchor _ =
  let head_sha = chain_current_head 0
  let head_idx = chain_current_idx 0
  if head_sha == "genesis" then
    http_response 200 "OK" "application/json" "{\"ok\":false,\"reason\":\"empty chain\"}"
  else if witness_alive 0 == 0 then
    http_response 503 "Service Unavailable" "application/json"
      (join "" ["{\"ok\":false,\"reason\":\"fleet0 witness offline\",\"head_sha\":\"", head_sha, "\",\"head_idx\":", show head_idx, "}"])
  else
    let attest_json = run_anchor_attest head_sha
    if length attest_json == 0 then
      http_response 502 "Bad Gateway" "application/json" (anchor_fail_body head_sha head_idx)
    else
      http_response 200 "OK" "application/json" (anchor_success_body head_sha head_idx attest_json)

-- /anchors  -- list of historical anchors
route_anchors _ =
  let content = read_file (cp_anchor 0)
  let lines = str_split "\n" content
  let entries = filter_nonempty lines
  let body = join "" ["[", join "," entries, "]"]
  http_response 200 "OK" "application/json" body

-- /estop -- arm e-stop. Drops suction, locks mutating routes.
route_estop _ =
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  let _ = save_state cp1 cp2 cp3 cp4 0   -- drop suction
  let _ = write_file estop_path "1"
  let _ = attest_action "estop" "" cp1 cp2 cp3 cp4 0
  -- Tell the real arm too (if bridged): vent_close to release any held object.
  let _ = bridge_send_suction 3
  -- and HALT all bus servos NOW: interrupt any in-flight move; servos hold, don't drop.
  let _ = bridge_send_halt 0
  http_response 200 "OK" "application/json"
    (state_json cp1 cp2 cp3 cp4 0 1 1 "commanded")

-- /clear -- release e-stop.
route_clear _ =
  let _ = shell (join "" ["rm -f ", estop_path])
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  let _ = attest_action "clear" "" cp1 cp2 cp3 cp4 csu
  http_response 200 "OK" "application/json"
    (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")

-- /actual -- return the arm's TRUE pose so the viewer can draw the ghost.
--   tcp  mode: send AA 55 READ_ANGLE via tools/read_arm_pose.sh.
--   fifo mode: read the live pulses tools/repl_relay.py polls + publishes to
--              real_pose_path (the REPL readback path).
--   off  mode: no real arm -> return /state verbatim (ghost stays hidden).
-- In every case FK is computed from the returned pulses by the SAME state_json
-- as /state, so the viewer's >2mm divergence check compares like with like.

read_arm_pose_path = "/Users/ledaticempire/projects/ledatic-arm/tools/read_arm_pose.sh"
real_pose_path     = "/tmp/armsim_real.txt"

route_actual_tcp _ =
  let host = bridge_tcp_host_resolved 0
  let port = bridge_tcp_port_resolved 0
  let cmd = join "" ["bash ", read_arm_pose_path, " ", host, " ", show port, " 2>/dev/null"]
  let result = shell cmd
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  -- No-readback fallbacks return validated COMMANDED state -> reachable per
  -- its committed value, loaded=1, joints="commanded" (C2).
  if length result == 0 then
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")
  else
    let parts = str_split " " result
    if length parts < 3 then
      http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")
    else
      let ap1 = parse_int_signed (head parts)
      let ap2 = parse_int_signed (head (tail parts))
      let ap3 = parse_int_signed (head (tail (tail parts)))
      -- A7 (C2): recompute reachability from the REAL pulses, joints="observed".
      -- tcp bridge has no relay/relax model -> loaded is always 1 (no sag).
      http_response 200 "OK" "application/json" (state_json ap1 ap2 ap3 cp4 csu (reach_from_pulses ap1 ap2 ap3) 1 "observed")

-- fifo/repl readback: relay publishes live servo pulses to real_pose_path.
-- Run the SAME FK as /state on them; wrist + suction stay commanded (cp4/csu),
-- mirroring route_actual_tcp. Empty/short file -> fall back to commanded state.
route_actual_fifo _ =
  let result = read_file real_pose_path
  let (cp1, cp2, cp3, cp4, csu) = load_state 0
  -- No-readback fallbacks return validated COMMANDED state -> reachable per
  -- its committed value, loaded=1, joints="commanded" (C2).
  if length result == 0 then
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")
  else
    let parts = str_split " " result
    if length parts < 3 then
      http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")
    else
      let ap1 = parse_int_signed (head parts)
      let ap2 = parse_int_signed (head (tail parts))
      let ap3 = parse_int_signed (head (tail (tail parts)))
      -- A2 (C1): 4th token is the loaded flag (1=loaded, 0=relaxed/sagging).
      -- BACKWARD-COMPATIBLE: a legacy 3-token file defaults lf=1 (loaded /
      -- authoritative) so a stale file NEVER falsely reads "relaxed".
      -- No short-circuit in Rail -> nested if/then/else (not &&) for the guard.
      let lf = if length parts < 4 then 1 else parse_int_signed (head (tail (tail (tail parts))))
      -- A7 (C2): recompute reachability from the REAL pulses, joints="observed".
      http_response 200 "OK" "application/json" (state_json ap1 ap2 ap3 cp4 csu (reach_from_pulses ap1 ap2 ap3) lf "observed")

route_actual _ =
  let mode = bridge_mode_env 0
  if mode == "tcp" then route_actual_tcp 0
  else if mode == "fifo" then route_actual_fifo 0
  else
    -- off mode: no real arm -> return /state verbatim (ghost stays hidden),
    -- loaded=1, joints="commanded" (C2).
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    http_response 200 "OK" "application/json" (state_json cp1 cp2 cp3 cp4 csu 1 1 "commanded")

-- /attest_observed?seq=&op1=&op2=&op3=&loaded= (A1 / C4)
-- The RELAY->RAIL seam: the Python relay (it holds the serial port) GETs this
-- after a commanded move settles, passing the arm's REAL bus-servo readback
-- (op1,op2,op3) plus a monotonic command seq and the loaded flag. We append an
-- OBSERVED chain entry recording the outcome, sharing prev_sha lineage with the
-- immediately-preceding commanded entry (command -> outcome -> command -> ...).
--
-- HONESTY RULE (C2/C4, shared with A7): only the three bus servos are sensable.
-- The LFD-01M wrist (p4_us) and the vacuum (su) are open-loop / un-sensable, so
-- the observed entry carries the REAL p1/p2/p3 readback but re-uses the
-- LAST-COMMANDED p4_us,su from load_state. We NEVER fabricate a wrist/suction
-- readback.
--
-- kind   = "observed"          when loaded=1 (the commanded outcome)
--        = "observed_relaxed"  when loaded=0 (servos unloaded -> a sag, A2)
-- params = "seq=<N>" (deterministic, no user bytes).
-- state  = "op1,op2,op3,<cp4>,<csu>" (5 ints, same canonical formula as
--          attest_action, so verify_chain.py needs NO change).
--
-- IDEMPOTENT BY seq: if seq <= the persisted last-observed seq we respond
-- {"ok":true,"dup":true} and chain nothing. Otherwise we chain, then persist
-- the new seq via the C6 tmp+rename convention.
--
-- NOT e-stop gated: an observed entry must record reality even after an e-stop.
-- The relay calls this OUTSIDE its serial _lock with a short timeout/try-except,
-- so it can never block motion -- the route itself just appends and returns.
observed_last_seq _ =
  let s = read_file (cp_observed_seq 0)
  if length s == 0 then 0 else parse_int_signed s

persist_observed_seq seq =
  let sp = cp_observed_seq 0
  let tmp = join "" [sp, ".tmp"]
  let _ = write_file tmp (show seq)
  let _ = shell (join "" ["mv -f ", tmp, " ", sp])
  0

route_attest_observed q =
  let seq = qp_get q "seq"
  let last_seq = observed_last_seq 0
  -- Idempotency: a retried or out-of-order trigger must NOT double-chain.
  if seq < last_seq + 1 then
    http_response 200 "OK" "application/json"
      (join "" ["{\"ok\":true,\"dup\":true,\"seq\":", show seq,
                ",\"last_seq\":", show last_seq, "}"])
  else
    let op1 = qp_get q "op1"
    let op2 = qp_get q "op2"
    let op3 = qp_get q "op3"
    -- loaded defaults to 1 (C1/C4 honesty: never silently treat as relaxed).
    let q_pairs = str_split "&" q
    let s_loaded = qp_search_str q_pairs "loaded"
    let loaded = if length s_loaded == 0 then 1 else qp_get q "loaded"
    -- Carry forward last-commanded wrist + suction (open-loop, un-sensable).
    let (cp1, cp2, cp3, cp4, csu) = load_state 0
    let kind = if loaded == 0 then "observed_relaxed" else "observed"
    let params = join "" ["seq=", show seq]
    -- Build the entry EXACTLY like attest_action (canonical = prev|t|kind|params|state)
    -- and persist via the shared A9 chain_persist helper. prev_sha == the
    -- preceding commanded entry's sha -> command/outcome lineage for free.
    let prev = chain_current_head 0
    let next_idx = (chain_current_idx 0) + 1
    let t = now_utc 0
    let state_canon = join "," [show op1, show op2, show op3, show cp4, show csu]
    let canonical = join "|" [prev, t, kind, params, state_canon]
    let new_sha = sha256_of canonical
    let entry = join "" ["{\"idx\":", show next_idx,
                         ",\"t\":\"", t,
                         "\",\"kind\":\"", kind,
                         "\",\"params\":\"", json_escape params,
                         "\",\"state\":\"", state_canon,
                         "\",\"prev_sha\":\"", prev,
                         "\",\"sha\":\"", new_sha, "\"}\n"]
    let _ = chain_persist new_sha next_idx entry
    -- Persist the seq AFTER the entry is committed (so a crash between the two
    -- only ever re-chains -- it never advances the seq past an unwritten entry).
    let _ = persist_observed_seq seq
    http_response 200 "OK" "application/json"
      (join "" ["{\"ok\":true,\"idx\":", show next_idx,
                ",\"sha\":\"", new_sha,
                "\",\"kind\":\"", kind, "\"}"])

-- /bridge_status -- last byte frame the bridge sent (if any) + mode
route_bridge_status _ =
  let s = read_file bridge_status_path
  let bmode = bridge_mode_env 0
  let body = if length s == 0 then
               join "" ["{\"mode\":\"", bmode, "\",\"last_frame_t\":null,\"last_frame_hex\":\"\",\"last_frame_desc\":\"\"}"]
             else s
  http_response 200 "OK" "application/json" body

-- ═════ Programs ═════
-- Each program is a .txt file in programs/ with one step per line:
--   <p1> <p2> <p3> <p4_us> <time_ms> <wait_ms> <suction>
-- Comments start with #.

-- ═════ Program pre-flight validation (A4 / C10) ═════
-- /validate_program?name=X is the CANONICAL, non-actuating validator: it
-- reads programs/<name>.txt, parses each non-comment step's first 3 pulse
-- fields, applies the SAME clamp_int (j*_p_lo/hi) and envelope_check (C9)
-- that route_pose uses to actuate, and emits one violation object per bad
-- step. NO save_state / attest / bridge_send -- safe to call with the bridge
-- ON. Both tools/program_runner.sh and route_program fail CLOSED on its
-- ok:false (defense in depth) so no FK is ever re-implemented in bash.
--
-- Step file format (C10 / shared contract): one step per line
--   <p1> <p2> <p3> <p4_us> <time_ms> <wait_ms> <suction>
-- with # comments and IRREGULAR whitespace (2-space gaps in real files).
-- str_split " " yields empty tokens on multi-space gaps -> filter_nonempty
-- before indexing. We validate the first 3 fields (the joint pulses that
-- become /pose p1 p2 p3); p4_us/suction don't affect the geometry envelope.

-- Drop a trailing '# comment' from a raw program line (keep the part before #).
prog_strip_comment_acc cs acc =
  if cs == [] then acc
  else if head cs == "#" then acc
  else prog_strip_comment_acc (tail cs) (join "" [acc, head cs])

prog_strip_comment line = prog_strip_comment_acc (chars line) ""

-- Map an envelope reason_code to the C10 violation label string.
--   1=floor (below table floor), 2=floor (below origin plane),
--   3=collision (tip inside base column), 4=reach (beyond max reach).
envelope_violation_label code =
  if code == 1 then "floor"
  else if code == 2 then "floor"
  else if code == 3 then "collision"
  else "reach"

-- Build one violation JSON object for a bad step (C10 shape).
prog_violation_obj step_idx p1 p2 p3 p4 code =
  let tip_z = fk_tip_z p1 p2 p3
  join "" ["{\"step\":", show step_idx,
           ",\"pulses\":[", show p1, ",", show p2, ",", show p3, ",", show p4,
           "],\"tip_z\":", sf tip_z,
           ",\"violation\":\"", envelope_violation_label code, "\"}"]

-- Validate one raw step line. Returns (counted, violation_or_empty):
--   counted        = 1 if the line is a real step (parsed >=3 pulses), else 0
--   violation_or_empty = the violation JSON if the (clamped) step fails the
--                        envelope, else "".
-- Clamp BEFORE envelope_check, mirroring route_pose:910-919 EXACTLY so
-- validation matches what would actually be actuated.
validate_program_step step_idx raw =
  let line = prog_strip_comment raw
  let toks = filter_nonempty (str_split " " line)
  if length toks < 3 then (0, "")
  else
    let p1 = clamp_int j1_p_lo j1_p_hi (parse_int_signed (head toks))
    let p2 = clamp_int j2_p_lo j2_p_hi (parse_int_signed (head (tail toks)))
    let p3 = clamp_int j3_p_lo j3_p_hi (parse_int_signed (head (tail (tail toks))))
    let p4 = if length toks < 4 then home_p4_us
             else clamp_int j4_us_lo j4_us_hi (parse_int_signed (head (tail (tail (tail toks)))))
    let (env_ok, env_code) = envelope_check p1 p2 p3
    if env_ok == 0 then (1, prog_violation_obj step_idx p1 p2 p3 p4 env_code)
    else (1, "")

-- Walk the program lines accumulating (steps, violations).
--   step_idx counts only real (non-comment, >=3-token) steps, 1-based, so the
--   "step":N in a violation matches the program_runner.sh step counter.
validate_program_lines lines step_idx steps_acc viol_acc =
  if lines == [] then (steps_acc, viol_acc)
  else
    let raw = head lines
    let (counted, viol) = validate_program_step (step_idx + 1) raw
    if counted == 0 then
      validate_program_lines (tail lines) step_idx steps_acc viol_acc
    else
      let next_idx = step_idx + 1
      let next_steps = steps_acc + 1
      let next_viol = if length viol == 0 then viol_acc else append viol_acc [viol]
      validate_program_lines (tail lines) next_idx next_steps next_viol

-- Core validation over a file's contents. Returns the JSON body string.
-- ok=true iff there are zero violations.
validate_program_body name content =
  let lines = str_split "\n" content
  let (steps, viols) = validate_program_lines lines 0 0 []
  let ok_str = if viols == [] then "true" else "false"
  join "" ["{\"ok\":", ok_str,
           ",\"program\":\"", json_escape name, "\"",
           ",\"steps\":", show steps,
           ",\"violations\":[", join "," viols, "]}"]

-- /validate_program?name=X
route_validate_program q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "application/json" "{\"ok\":false,\"reason\":\"missing name\"}"
  else
    let prog_file = join "" [programs_dir_default, "/", name, ".txt"]
    -- shell() keeps the trailing newline, so compare against "y" (tr -strip)
    -- rather than "n" -- a missing program must FAIL CLOSED (404), never
    -- validate as an empty 0-step program (which would read ok:true).
    let exists_check = shell (join "" ["{ test -f ", prog_file, " && echo y || echo n; } | tr -d '\n'"])
    if exists_check == "y" then
      let content = read_file prog_file
      http_response 200 "OK" "application/json" (validate_program_body name content)
    else
      http_response 404 "Not Found" "application/json"
        (join "" ["{\"ok\":false,\"reason\":\"program not found\",\"program\":\"", json_escape name, "\"}"])

route_programs _ =
  let cmd = join "" ["ls -1 ", programs_dir_default, "/*.txt 2>/dev/null | sed 's|.*/||;s|\\.txt$||'"]
  let listing = shell cmd
  let lines = str_split "\n" listing
  let items = pose_list_items lines
  let body = join "" ["[", join "," items, "]"]
  http_response 200 "OK" "application/json" body

pose_list_items lines =
  if lines == [] then []
  else
    let line = head lines
    if length line == 0 then pose_list_items (tail lines)
    else
      let item = join "" ["{\"name\":\"", json_escape line, "\"}"]
      cons item (pose_list_items (tail lines))

-- /program?name=X  -- background-launch the runner
route_program q =
  let name = qp_get_str q "name"
  if length name == 0 then
    http_response 400 "Bad Request" "application/json" "{\"ok\":false,\"reason\":\"missing name\"}"
  else
    let prog_file = join "" [programs_dir_default, "/", name, ".txt"]
    -- shell() keeps the trailing newline; compare against "y" (tr-stripped) so
    -- a MISSING program fails closed (404) and never reaches the launch path
    -- with an empty 0-step file.
    let exists_check = shell (join "" ["{ test -f ", prog_file, " && echo y || echo n; } | tr -d '\n'"])
    if exists_check == "y" then
      -- A4 (C10) defense-in-depth: run the SAME pre-flight validator inline and
      -- REFUSE to launch the runner (HTTP 422, no save_state/attest/bridge) if
      -- any step violates the envelope. The runner gates too, but this enforces
      -- the gate even when /program is hit directly, by hand, or by a stale
      -- runner. The non-actuating validate is fast (FK only).
      let content = read_file prog_file
      let lines = str_split "\n" content
      let (steps, viols) = validate_program_lines lines 0 0 []
      if viols == [] then
        let _ = shell (join "" ["( bash ", program_runner_path, " ", prog_file,
                                " & echo $! > ", program_pid_path, " ) >/dev/null 2>&1 &"])
        let _ = attest_action "program_start" (join "" ["name=", name]) 0 0 0 0 0
        http_response 202 "Accepted" "application/json"
          (join "" ["{\"ok\":true,\"program\":\"", json_escape name, "\",\"started\":true}"])
      else
        http_response 422 "Unprocessable Entity" "application/json"
          (join "" ["{\"ok\":false,\"program\":\"", json_escape name, "\"",
                    ",\"steps\":", show steps,
                    ",\"reason\":\"pre-flight failed: step(s) violate the safety envelope\"",
                    ",\"violations\":[", join "," viols, "]}"])
    else
      http_response 404 "Not Found" "application/json"
        (join "" ["{\"ok\":false,\"reason\":\"program not found\",\"name\":\"", json_escape name, "\"}"])

-- /program/stop  -- kill any running runner
route_program_stop _ =
  let pid = read_file program_pid_path
  if length pid == 0 then
    http_response 200 "OK" "application/json" "{\"ok\":true,\"stopped\":false,\"reason\":\"no program running\"}"
  else
    let _ = shell (join "" ["kill ", pid, " 2>/dev/null; pkill -P ", pid, " 2>/dev/null"])
    let _ = shell (join "" ["rm -f ", program_pid_path])
    let _ = attest_action "program_stop" "" 0 0 0 0 0
    http_response 200 "OK" "application/json" "{\"ok\":true,\"stopped\":true}"

-- ═════ Index ═════
route_index _ =
  let html = read_file html_path
  if length html == 0 then
    http_response 500 "Internal Server Error" "text/plain" "armsim: index.html not found"
  else
    http_response 200 "OK" "text/html" html

route_404 path =
  http_response 404 "Not Found" "text/plain" (join "" ["404 ", path])

-- ═════ Main dispatch ═════
main =
  let req = read_file req_path
  let path = http_path_with_query req
  let plain = strip_query path
  let query = extract_query path
  let resp =
    if plain == "/" then route_index 0
    else if plain == "/state" then route_state 0
    else if plain == "/selftest_geom" then route_selftest_geom 0
    else if plain == "/pose" then route_pose query
    else if plain == "/reach" then route_reach query
    else if plain == "/nozzle" then route_nozzle query
    else if plain == "/suction" then route_suction query
    else if plain == "/home" then route_home query
    else if plain == "/poses" then route_poses 0
    else if plain == "/poses/save" then route_poses_save query
    else if plain == "/poses/load" then route_poses_load query
    else if plain == "/poses/delete" then route_poses_delete query
    else if plain == "/chain" then route_chain 0
    else if plain == "/anchor" then route_anchor 0
    else if plain == "/anchors" then route_anchors 0
    else if plain == "/estop" then route_estop 0
    else if plain == "/clear" then route_clear 0
    else if plain == "/actual" then route_actual 0
    else if plain == "/attest_observed" then route_attest_observed query
    else if plain == "/bridge_status" then route_bridge_status 0
    else if plain == "/programs" then route_programs 0
    else if plain == "/validate_program" then route_validate_program query
    else if plain == "/program" then route_program query
    else if plain == "/program/stop" then route_program_stop 0
    else route_404 plain
  let _ = write_file "/dev/stdout" resp
  0
