      "id": 1, "name": "base_yaw", "axis": "z", "type": "bus_servo",
      "servo_model": "Hiwonder HTS-35H", "servo_bus_id": 1,
      "pulse_min": 0, "pulse_max": 1000, "pulse_home": 500,
      "degrees_min": 0, "degrees_max": 240, "degrees_per_pulse": 0.24,
      "_note": "No firmware clamp; physical limit imposed by wiring loom — sweep on delivery"
    },
    {
      "id": 2, "name": "shoulder", "axis": "y", "type": "bus_servo",
      "servo_model": "Hiwonder HTS-35H", "servo_bus_id": 2,
