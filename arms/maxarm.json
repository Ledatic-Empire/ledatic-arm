      "degrees_min": 0, "degrees_max": 168, "degrees_per_pulse": 0.24,
      "_clamp": "firmware clamps pulse > 700 -> 700 (espmax.py set_servo_in_range)"
    },
    {
      "id": 3, "name": "elbow", "axis": "y", "type": "bus_servo",
      "servo_model": "Hiwonder HTS-35H", "servo_bus_id": 3,
      "pulse_min": 470, "pulse_max": 1000, "pulse_home": 500,
      "degrees_min": 113, "degrees_max": 240, "degrees_per_pulse": 0.24,
      "_clamp": "firmware clamps pulse < 470 -> 470 (espmax.py set_servo_in_range)"
